{
  "version": 1,
  "purpose": "Step 14 primary equal-evaluation-budget comparison; ten paired seeds, affine and supported nonlinear regression. No tuning or default change.",
  "seeds": [400,401,402,403,404,405,406,407,408,409],
  "development_seeds": [0,300,301,302],
  "training_error_targets": [1,0.1,0.01,1e-8],
  "evaluation_checkpoints": [1,10,25,50,100,250,500],
  "acceptance_error": 1e-8,
  "algorithms": ["hc","univariate","boa","hboa"],
  "parameters": {
    "problem":"sr", "continDepth":2, "continStep":1, "continExpansion":2,
    "continPolyDegree":2, "continScaffoldDepth":1, "continOperators":"(c_add c_mul)",
    "continMaxScaffoldNodes":10000, "continComplexityRatio":0,
    "continImprovementThreshold":-0.0001, "maxGen":10, "nDeme":1, "maxEvals":500,
    "optimizerMaxProposals":100000, "optimizerMaxGenerations":1000,
    "optimizerTimeLimitSec":-1, "hcWidenSearch":false, "hcCrossover":true,
    "maxDist":4, "revisit":0, "diagnostics":true, "continTrace":true,
    "edaPopulationSize":32, "edaSelectionSize":16, "edaOffspringSize":16,
    "edaTournamentSize":2, "edaPseudocount":1, "edaExploration":0.1,
    "edaMaxRefillAttempts":256, "edaStagnationGenerations":10,
    "boaMaxParents":2, "boaMaxTableCells":256, "boaMaxIterations":16,
    "boaMaxScoreCalls":256, "boaFitTimeLimitSec":10,
    "hboaMaxParents":3, "hboaMaxDepth":3, "hboaMaxLeaves":8,
    "hboaMinSupport":2, "hboaMaxIterations":16, "hboaMaxScoreCalls":256,
    "hboaFitTimeLimitSec":10, "hboaLearnDependencies":true,
    "edaRTRWindow":8, "edaReplacement":"auto"
  },
  "cases": [
    {"name":"linear","family":"affine","loss":"squared_error","equation":"1 + 2*x","identifiable":true,"coefficients":{"bias":1,"x":2},"parameters":{"problem":"linear","continSearchMode":"linear"}},
    {"name":"multivariate","family":"affine","loss":"squared_error","equation":"1 + 2*x - z","identifiable":true,"coefficients":{"bias":1,"x":2,"z":-1},"parameters":{"problem":"linear","continSearchMode":"linear"}},
    {"name":"absolute","family":"affine","loss":"abs_error","equation":"-1 + 0.5*x","identifiable":true,"coefficients":{"bias":-1,"x":0.5},"parameters":{"problem":"linear","continSearchMode":"linear"}},
    {"name":"correlated","family":"affine","loss":"squared_error","equation":"1 + 3*x with z=2*x","identifiable":false,"parameters":{"problem":"linear","continSearchMode":"linear"}},
    {"name":"sr-cubic","family":"nonlinear","loss":"squared_error","equation":"1 + x - x*x + x*x*x","identifiable":false,"parameters":{"continPolyDegree":3,"continOperators":"(c_add c_mul)"}},
    {"name":"sr-interaction","family":"nonlinear","loss":"squared_error","equation":"1 + x*x + x*z - z*z","identifiable":false,"parameters":{"continPolyDegree":2,"continOperators":"(c_add c_mul)"}},
    {"name":"sr-quartic-interaction","family":"nonlinear","loss":"squared_error","equation":"1 + x*z + x*x*z*z","identifiable":false,"parameters":{"continPolyDegree":4,"continOperators":"(c_add c_mul)"}},
    {"name":"sr-sine","family":"nonlinear","loss":"squared_error","equation":"sin(x + x*x)","identifiable":false,"parameters":{"continPolyDegree":2,"continOperators":"(c_add c_mul c_sin)"}},
    {"name":"sr-exp","family":"nonlinear","loss":"squared_error","equation":"exp(x)","identifiable":false,"parameters":{"continPolyDegree":1,"continOperators":"(c_add c_mul c_exp)"}}
  ]
}
