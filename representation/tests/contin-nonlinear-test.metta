!(import! &self ../contin-nonlinear)
!(import! &self ../build-nonlinear)
(= (leaf $v) (mkTree (mkNode $v) ()))
(= (node $op $children) (mkTree (mkNode $op) $children))
(= (cfg) (mkNonlinearConfig 2 1 (c_add c_mul) 10000))
(= (ctx) (mkContinCtx (mkITable ((-2 -1 0 1 2) (2 0 0 2 6)) (x y)) squared_error 0 nonlinear 0))
(= (rep) (buildNonlinearRepresentation (leaf 0) (ctx) 1 2 1 (cfg)))
(= (square) (node c_mul ((leaf x) (leaf x))))
(= (orderTwo) (node c_add ((leaf x) (square))))
!(assertEqual (nonlinearConfigValid (cfg)) True)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 0 1 (c_add c_mul) 10000)) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 5 1 (c_add c_mul) 10000)) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 2 3 (c_add c_mul) 10000)) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 2 1 (c_add c_mul c_cos) 10000)) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 2 1 (c_add c_mul c_mul) 10000)) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 2 1 (c_add) 10000)) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig bad 1 (c_add c_mul) 10000)) False)
!(assertEqual (nonlinearConfigValid malformed) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 2 1 malformed 10000)) False)
!(assertEqual (nonlinearConfigValid (mkNonlinearConfig 2 1 (c_add c_mul) 100001)) False)
!(assertEqual (cnMonomials (x z) 2 1)
 ((leaf x) (leaf z) (square) (node c_mul ((leaf x) (leaf z))) (node c_mul ((leaf z) (leaf z)))))
!(assertEqual (continListLength (cnMonomials (x z) 3 1)) 9)
!(assertEqual (continListLength (cnMonomials (x z) 4 1)) 14)
!(assertEqual (continNonlinearCanonize (leaf 0) (x) (cfg))
 (node c_add ((leaf 0.0) (node c_mul ((leaf 0.0) (leaf x))) (node c_mul ((leaf 0.0) (square))))))
!(assertEqual (fieldSchemaValid (continFieldSchema (rep))) True)
!(assertEqual (continListLength (schemaFields (continFieldSchema (rep)))) 3)
!(assertEqual (finalizeContinCandidate (rep) (mkInst (0 0 2))) (square))
!(assertEqual (finalizeContinCandidate (rep) (mkInst (0 2 2))) (orderTwo))
!(assertEqual (finalizeContinCandidate (rep) (mkInst (2 0 0))) (leaf 1.0))
!(assertEqual (continScoreTree (orderTwo) (ctx)) (mkCscore 0.0 3 0 0.0 0.0))
!(assertEqual (continAffineCanonize (square) (x)) (mkCEvalError "UnsupportedAffineForm"))
!(assertEqual (continNonlinearCanonize malformed (x) (cfg)) (mkCEvalError "InvalidNonlinearVocabularyOrTree"))
!(assertEqual (continNonlinearCanonize (leaf missing) (x) (cfg)) (mkCEvalError "InvalidNonlinearVocabularyOrTree"))
!(assertEqual (continNonlinearCanonize (node c_mul ((leaf 0) (node c_sin ((leaf x))))) (x) (cfg))
 (mkCEvalError "InvalidNonlinearVocabularyOrTree"))
!(assertEqual (continNonlinearCanonize (node c_mul ((leaf 0) (leaf missing))) (x) (cfg))
 (mkCEvalError "InvalidNonlinearVocabularyOrTree"))
!(assertEqual (continNonlinearCanonize (leaf 0) (x x) (cfg)) (mkCEvalError "InvalidNonlinearLabels"))
!(assertEqual (continNonlinearCanonize (leaf 0) (x) (mkNonlinearConfig 2 1 (c_add c_mul) 1))
 (mkCEvalError "NonlinearScaffoldLimit"))
!(assertEqual (continNonlinearCanonize (leaf 0) (a b c d e f g h i j) (mkNonlinearConfig 4 2 (c_add c_mul c_div c_sin c_log c_exp) 10000))
 (mkCEvalError "NonlinearScaffoldLimit"))

;; Every depth-one polynomial instance retains its phenotype after rebuilding;
;; field counts restore missing zero slots without growing across demes.
(= (vectors $n)
 (if (== $n 0) (())
  (foldl-atom (0 1 2) () $acc $h
   (continAppend $acc (map-atom (vectors (- $n 1)) $tail (cons $h $tail))))))
(= (rebuildOK $vector)
 (let* (($tree (finalizeContinCandidate (rep) (mkInst $vector)))
        ($rebuilt (buildNonlinearRepresentation $tree (ctx) 1 2 1 (cfg)))
        ($schema (continFieldSchema $rebuilt))
        ($default (finalizeContinCandidate $rebuilt (schemaDefaultInstance $schema))))
  (and (== $default $tree) (== (continListLength (schemaFields $schema)) 3))))
!(assertEqual (continListLength (vectors 3)) 27)
!(assertEqual (foldl-atom (vectors 3) True $ok $v (and $ok (rebuildOK $v))) True)

;; Trainable recursive function arguments; default gates do not evaluate log(x)
;; or divide at x=0. Unsupported arities fail before any numeric reduction.
(= (fullCfg) (mkNonlinearConfig 1 1 (c_add c_mul c_sin c_log c_exp c_div) 10000))
(= (fullRep $tree) (buildNonlinearRepresentation $tree (ctx) 1 2 1 (fullCfg)))
(= (fullDefault $tree)
 (let $r (fullRep $tree) (finalizeContinCandidate $r (schemaDefaultInstance (continFieldSchema $r)))))
!(assertEqual (fieldSchemaValid (continFieldSchema (fullRep (leaf 0)))) True)
!(assertEqual (fullDefault (leaf 0)) (leaf 0.0))
!(assertEqual (fullDefault (node c_sin ((leaf x)))) (node c_sin ((leaf x))))
!(assertEqual (fullDefault (node c_log ((leaf x)))) (node c_log ((leaf x))))
!(assertEqual (fullDefault (node c_exp ((leaf x)))) (node c_exp ((leaf x))))
!(assertEqual (fullDefault (node c_div ((leaf x) (node c_add ((leaf 1) (leaf x))))))
 (node c_div ((leaf x) (node c_add ((leaf 1.0) (leaf x))))))
!(assertEqual (> (continListLength (schemaFields (continFieldSchema (fullRep (leaf 0))))) 6) True)
!(assertEqual (continNonlinearCanonize (node c_sin ((leaf x) (leaf x))) (x) (fullCfg))
 (mkCEvalError "InvalidNonlinearVocabularyOrTree"))
!(assertEqual (continNonlinearCanonize (node c_div ((leaf x))) (x) (fullCfg))
 (mkCEvalError "InvalidNonlinearVocabularyOrTree"))
!(assertEqual (reduceContinTree (node c_add ((square) (square))))
 (node c_mul ((leaf 2.0) (square))))
!(assertEqual (continEval (reduceContinTree (node c_add ((square) (square)))) ((mkContinBinding x 3))) (mkCEvalOk 18.0))
!(assertEqual (continEval (reduceContinTree (node c_add ((square) (square)))) ((mkContinBinding x 1e308))) (mkCEvalError "NonFinite"))
!(assertEqual (reduceContinTree (node c_log ((node c_exp ((leaf x)))))) (node c_log ((node c_exp ((leaf x))))))
!(assertEqual (continEval (reduceContinTree (node c_log ((node c_exp ((leaf 1000)))))) ()) (mkCEvalError "NonFinite"))

;; Explicit legal vectors from ZERO, not targets supplied as seed exemplars.
;; These pin the grammar and recursive field order used by the harder fixtures.
(= (fixtureDecode $labels $degree $ops $vector)
 (let* (($scaffold (continNonlinearCanonize (leaf 0) $labels (mkNonlinearConfig $degree 1 $ops 10000)))
        ($r (buildContinRepresentation $scaffold 1 2 1)))
   (finalizeContinCandidate $r (mkInst $vector))))
!(assertEqual (fixtureDecode (x z) 2 (c_add c_mul) (2 0 0 2 2 1))
 (node c_add ((leaf 1.0) (square) (node c_mul ((leaf x) (leaf z)))
   (node c_mul ((leaf -1.0) (node c_mul ((leaf z) (leaf z))))))))
!(assertEqual (fixtureDecode (x) 3 (c_add c_mul) (2 2 1 2))
 (node c_add ((leaf 1.0) (leaf x) (node c_mul ((leaf -1.0) (square)))
   (node c_mul ((leaf x) (leaf x) (leaf x))))))
!(assertEqual (fixtureDecode (x z) 4 (c_add c_mul) (2 0 0 0 2 0 0 0 0 0 0 0 2 0 0))
 (node c_add ((leaf 1.0) (node c_mul ((leaf x) (leaf z)))
   (node c_mul ((leaf x) (leaf x) (leaf z) (leaf z))))))
!(assertEqual (fixtureDecode (x) 2 (c_add c_mul c_sin) (0 0 0 2 0 0 2 0))
 (node c_sin ((node c_add ((leaf x) (square))))))
!(assertEqual (fixtureDecode (x) 2 (c_add c_mul c_log) (0 0 0 2 1 2 2 0))
 (node c_log ((node c_add ((leaf 1.0) (square))))))
!(assertEqual (fixtureDecode (x) 1 (c_add c_mul c_exp) (0 0 2 0 0 0)) (node c_exp ((leaf x))))
!(assertEqual (fixtureDecode (x) 2 (c_add c_mul c_div) (0 0 0 2 0 0 0 0 0 0 0 2 0 0))
 (node c_div ((leaf x) (node c_add ((leaf 1.0) (square))))))
