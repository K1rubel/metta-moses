(= (heteroRep)
   (mkRep (mkKbMap (mkDscMp (continAppend (continRawSlice (mkNodeId (1)) 0 1) (continRawSlice (mkNodeId (2)) 0 3))))
     (node c_add ((mkTree (mkCTK (mkContinSpec 10.0 2.0 1.0 1) 0) ())
                  (mkTree (mkCTK (mkContinSpec -2.0 1.0 2.0 3) 1) ())))))
