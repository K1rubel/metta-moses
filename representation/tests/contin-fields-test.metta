;; Mixed cardinalities, nonzero discrete defaults and compacted/pruned knobs.
(= (mixedSchema)
   (mkFieldSchema (continAppend ((mkField 0 4 3 choice discrete 0 0 ()))
     (continAppend (continFieldSlice coefficient (mkContinSpec 0 1 2 2) 1 0)
       ((mkField 3 2 0 flag discrete 0 3 ()))))))
!(assertEqual (fieldSchemaValid (mixedSchema)) True)
!(assertEqual (schemaDefaultInstance (mixedSchema)) (mkInst (3 0 0 0)))
!(assertEqual (canonicalizeInstance (mixedSchema) (mkInst (0 0 2 1))) (mkInst (0 0 0 1)))
!(assertEqual (instanceModelView (mixedSchema) (mkInst (0 0 2 1)))
              ((mkActiveField 0 0) (mkActiveField 1 0) (mkInactiveField 2) (mkActiveField 3 1)))
!(assertEqual (discreteFieldSchema (mkDscMp (((mkDiscSpec 2) (mkLSK (mkDiscKnob (mkMultip 4) (mkDiscSpec 3) (mkDiscSpec 3) ((mkDiscSpec 0) (mkDiscSpec 1))))))))
              (mkFieldSchema ((mkField 0 2 0 (mkDiscreteOwner 0) discrete 0 0 ()))))
!(assertEqual (discreteFieldSchema (mkDscMp (((mkDiscSpec 2) (mkDiscKnob (mkMultip 4) (mkDiscSpec 0) (mkDiscSpec 0) ()))))) (mkCEvalError "InvalidDiscreteField"))
!(assertEqual (discreteFieldSchema (mkDscMp (((mkDiscSpec 3) bogus)))) (mkCEvalError "InvalidDiscreteField"))

;; Canonicalization across ALL 81 raw depth-two/two-owner vectors produces 49
;; distinct instances, and preserves every materialized phenotype.
(= (distinctCanonical $rows $schema $seen)
   (case $rows
     ((() $seen)
      ((cons $values $rest)
       (let $inst (canonicalizeInstance $schema (mkInst $values))
         (distinctCanonical $rest $schema (if (continContains $inst $seen) $seen (cons $inst $seen))))))))
(= (allMaterializationParity $rows)
   (case $rows
     ((() True)
      ((cons $values $rest)
       (let $inst (canonicalizeInstance (schema2) (mkInst $values))
         (if (and (== $inst (canonicalizeInstance (schema2) $inst))
                  (== (materializeContinCandidate (rep2) (mkInst $values)) (materializeContinCandidate (rep2) $inst)))
             (allMaterializationParity $rest) False))))))
!(assertEqual (continListLength (distinctCanonical (allTritVectors 4) (schema2) ())) 49)
!(assertEqual (allMaterializationParity (allTritVectors 4)) True)

;; Seeded samples, complete bounded initialization, duplicate-only termination.
!(assertEqual (sampleLegalInstance (schema2) 1) (mkLegalSample (mkInst (0 0 2 1)) 1914720637))
!(assertEqual (sampleLegalInstance (mkFieldSchema ()) 1) (mkLegalSample (mkInst ()) 1))
!(assertEqual (sampleLegalInstance (schema2) 0) (mkCEvalError "InvalidSamplingConfiguration"))
!(assertEqual (sampleLegalInstance (schema2) 2147483647) (mkCEvalError "InvalidSamplingConfiguration"))
!(assertEqual (sampleLegalInstance (schema2) 1.0) (mkCEvalError "InvalidSamplingConfiguration"))
!(assertEqual (sampleLegalInstance malformed 1) (mkCEvalError "InvalidFieldSchema"))
!(assertEqual (sampleLegalPopulation (schema2) -1 3 1) (mkCEvalError "InvalidSamplingConfiguration"))
!(assertEqual (sampleLegalPopulation (schema2) 3 -1 1) (mkCEvalError "InvalidSamplingConfiguration"))
!(assertEqual (sampleLegalPopulation (schema2) 3 0 1) (mkLegalPopulation ((mkInst (0 0 0 0))) 1 0 sampleAttemptsExhausted))
!(assertEqual (sampleLegalInstance (mkFieldSchema ((mkField 0 2147483647 0 owner discrete 0 0 ()))) 1)
              (mkCEvalError "InvalidSamplingConfiguration"))
(= (samplesLegal $schema $n $rng)
   (if (== $n 0) True
       (let (mkLegalSample $inst $next) (sampleLegalInstance $schema $rng)
         (if (== $inst (canonicalizeInstance $schema $inst)) (samplesLegal $schema (- $n 1) $next) False))))
(= (uniqueLegalRows $schema $rows $seen)
   (case $rows
     ((() True)
      ((cons $inst $rest)
       (if (and (== $inst (canonicalizeInstance $schema $inst)) (not (continContains $inst $seen)))
           (uniqueLegalRows $schema $rest (cons $inst $seen)) False)))))
!(assertEqual (samplesLegal (schema2) 256 1) True)
!(assertEqual (samplesLegal (mixedSchema) 256 1) True)
!(assertEqual (samplesLegal (continFieldSchema (heteroRep)) 256 2) True)
!(bind! &pop (new-state (sampleLegalPopulation (schema2) 49 2000 1)))
!(assertEqual (legalPopulationReason (get-state &pop)) sampleComplete)
!(assertEqual (continListLength (legalPopulationInstances (get-state &pop))) 49)
!(assertEqual (uniqueLegalRows (schema2) (legalPopulationInstances (get-state &pop)) ()) True)
!(assertEqual (car-atom (legalPopulationInstances (get-state &pop))) (mkInst (0 0 0 0)))
!(assertEqual (<= (legalPopulationProposals (get-state &pop)) 2000) True)
!(assertEqual (get-state &pop) (sampleLegalPopulation (schema2) 49 2000 1))
!(assertEqual (legalPopulationReason (sampleLegalPopulation (schema2) 50 100 1)) sampleAttemptsExhausted)
!(assertEqual (legalPopulationProposals (sampleLegalPopulation (schema2) 50 100 1)) 100)

;; REAL materialization/scoring through shared service, not callback stubs.
(= (ctx) (mkContinCtx (mkITable ((0 1 2) (1 3 5)) (x y)) squared_error 0 linear 0))
(= (pending $values) (mkEvaluatedCandidate (mkInst $values) () () candidatePending))
(= (summary $batch)
   ((continListLength (batchEvaluated $batch)) (continListLength (batchPending $batch))
    (batchActualEvaluations $batch) (batchCacheHits $batch) (batchDecodeFailures $batch)))
!(resetCandidateScoreCache)
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 2 0 1))) (rep2) id (ctx) 0)) (0 1 0 0 0))
!(assertEqual (candidateInstance (car-atom (batchPending (evaluateCandidateBatch ((pending (0 2 0 1))) (rep2) id (ctx) 0)))) (mkInst (0 0 0 0)))
!(bind! &batch (new-state (evaluateCandidateBatch ((pending (0 2 0 1)) (pending (0 1 0 2)) (pending (2 1 0 0))) (rep2) id (ctx) 1)))
!(assertEqual (summary (get-state &batch)) (2 1 1 1 0))
!(assertEqual (candidateInstance (car-atom (batchEvaluated (get-state &batch)))) (mkInst (0 0 0 0)))
!(assertEqual (candidateScore (car-atom (batchEvaluated (get-state &batch)))) (mkCscore 0.0 3 0 0.0 0.0))
!(assertEqual (summary (evaluateCandidateBatch (batchPending (get-state &batch)) (rep2) id (ctx) 1)) (1 0 1 0 0))
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 0 0 0))) (rep2) id (ctx) 0)) (1 0 0 1 0))
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 8 0 0)) (pending (0 8 0 0))) (rep2) id (ctx) 0)) (2 0 0 1 1))
!(assertEqual (summary (evaluateCandidateBatch ((pending (2 2)) (pending (2 2)))
                (buildContinRepresentation (leaf 0) 1e308 2 2) overflowId (ctx) 0)) (2 0 0 1 1))
!(assertEqual (collapse (materializeContinCandidate (rep2) (mkInst (0 2 0 1)))) ((affine)))
;; Rebuilt anchors change the phenotype; the old score cache cannot stand in.
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 0 0 0)))
                (buildContinRepresentation (node c_add ((node c_mul ((leaf 3.0) (leaf x))) (leaf 1.0))) 1.0 2.0 2)
                rebuiltId (ctx) 1)) (1 0 1 0 0))
