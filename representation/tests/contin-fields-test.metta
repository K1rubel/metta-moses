;; Production decoder vs the independent decodeTritList fixture for EVERY raw
;; depth-five vector, plus non-default means/steps/expansions. 243 cases per spec.
(= (prependTrit $t $rows)
   (case $rows ((() ()) ((cons $row $rest) (cons (cons $t $row) (prependTrit $t $rest))))))
(= (allTritVectors $depth)
   (if (== $depth 0) (())
       (let $tails (allTritVectors (- $depth 1))
         (continAppend (prependTrit 0 $tails) (continAppend (prependTrit 1 $tails) (prependTrit 2 $tails))))))
(= (allStepperParity $rows $spec)
   (case $rows
     ((() True)
      ((cons $row $rest)
       (if (== (decodeContinSlice $spec $row)
               (mkCEvalOk (decodeTritList (continSpecMean $spec) (continSpecStep $spec) True True (continSpecExpansion $spec) $row)))
           (allStepperParity $rest $spec) False)))))
(= (allCanonicalParity $rows $spec)
   (case $rows
     ((() True)
      ((cons $row $rest)
       (let $canonical (canonicalContinSlice $spec $row)
         (if (and (== $canonical (canonicalContinSlice $spec $canonical))
                  (== (decodeContinSlice $spec $row) (decodeContinSlice $spec $canonical)))
             (allCanonicalParity $rest $spec) False))))))
!(assertEqual (continListLength (allTritVectors 5)) 243)
!(assertEqual (allStepperParity (allTritVectors 5) (defaultContinSpec 0.0)) True)
!(assertEqual (allStepperParity (allTritVectors 5) (mkContinSpec 17.5 0.5 2.0 5)) True)
!(assertEqual (allStepperParity (allTritVectors 5) (mkContinSpec -4.0 1.0 1.0 5)) True)
!(assertEqual (allStepperParity (allTritVectors 5) (mkContinSpec 0.0 1.0 3.0 5)) True)
!(assertEqual (allStepperParity (allTritVectors 5) (mkContinSpec 0.0 1.0 0.5 5)) True)
!(assertEqual (allCanonicalParity (allTritVectors 5) (defaultContinSpec 0.0)) True)
!(assertEqual (decodeContinSlice (mkContinSpec 0.0 1e308 2.0 1) (2)) (mkCEvalOk 1e308))
!(assertEqual (decodeContinSlice (mkContinSpec 0.0 1e308 2.0 2) (2 0)) (mkCEvalOk 1e308))
!(assertEqual (decodeContinSlice (mkContinSpec 0.0 1e308 2.0 2) (2 2)) (mkCEvalError "NonFinite"))
!(assertEqual (decodeContinSlice (defaultContinSpec 3) (0 0 0 0 0)) (mkCEvalOk 3.0))
!(assertEqual (decodeContinSlice (defaultContinSpec 0) (2 1)) (mkCEvalError "InvalidSliceLength"))
!(assertEqual (decodeContinSlice (defaultContinSpec 0) (0 0 0 0 0 0)) (mkCEvalError "InvalidSliceLength"))
!(assertEqual (decodeContinSlice (defaultContinSpec 0) badList) (mkCEvalError "InvalidSliceLength"))
!(assertEqual (decodeContinSlice (defaultContinSpec 0) (0 0 0 0 -1)) (mkCEvalError "InvalidTrit"))
!(assertEqual (decodeContinSlice (defaultContinSpec 0) (0 0 0 0 1.0)) (mkCEvalError "InvalidTrit"))
!(assertEqual (decodeContinSlice (defaultContinSpec 0) (0 0 0 0 True)) (mkCEvalError "InvalidTrit"))
!(assertEqual (decodeContinSlice (mkContinSpec 0 0 2 5) (0 0 0 0 0)) (mkCEvalError "InvalidContinSpec"))
!(assertEqual (decodeContinSlice (mkContinSpec 0 1 0 5) (0 0 0 0 0)) (mkCEvalError "InvalidContinSpec"))
!(assertEqual (decodeContinSlice (mkContinSpec 0 1 2 0) ()) (mkCEvalError "InvalidContinSpec"))
!(assertEqual (decodeContinSlice (mkContinSpec 0 1 2 2.5) (0 0)) (mkCEvalError "InvalidContinSpec"))
!(assertEqual (continSpecValid (mkContinSpec (py-call (builtins.float "nan")) 1 2 5)) False)
!(assertEqual (continSpecValid (mkContinSpec 0 (py-call (builtins.float "inf")) 2 5)) False)
!(assertEqual (continSpecValid (mkContinSpec 0 1 (py-call (builtins.float "inf")) 5)) False)
!(assertEqual (continSpecValid malformed) False)
!(assertEqual (canonicalContinSlice (defaultContinSpec 0) (0 0 0 0 4)) (mkCEvalError "InvalidTrit"))

