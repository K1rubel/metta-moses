(= (leaf $v) (mkTree (mkNode $v) ()))
(= (node $op $children) (mkTree (mkNode $op) $children))
(= (ctx) (mkContinCtx (mkITable ((0 1 2) (1 2 3) (1 3 5)) (x z y)) squared_error 0.1 linear 0))
(= (affine) (node c_add ((leaf 1) (node c_mul ((leaf 2) (leaf x))))))
(= (rep) (defaultAffineRepresentation (affine) (ctx)))
(= (schema) (continFieldSchema (rep)))
!(assertEqual (reduceContinTree (node c_add ())) (leaf 0.0))
!(assertEqual (reduceContinTree (node c_mul ())) (leaf 1.0))
!(assertEqual (reduceContinTree (node c_add ((leaf 2) (leaf 3)))) (leaf 5.0))
!(assertEqual (reduceContinTree (node c_mul ((leaf 2) (leaf 3)))) (leaf 6.0))
!(assertEqual (reduceContinTree (node c_add ((leaf x) (leaf 0)))) (leaf x))
!(assertEqual (reduceContinTree (node c_mul ((leaf x) (leaf 1)))) (leaf x))
!(assertEqual (reduceContinTree (node c_mul ((leaf 0) (node c_log ((leaf -1)))))) (leaf 0.0))
!(assertEqual (reduceContinTree (node c_mul ((node c_log ((leaf -1))) (leaf 0))))
              (node c_mul ((node c_log ((leaf -1.0))) (leaf 0.0))))
!(assertEqual (reduceContinTree (node c_div ((leaf x) (leaf 2)))) (node c_mul ((leaf 0.5) (leaf x))))
!(assertEqual (reduceContinTree (node c_div ((leaf x) (leaf 3)))) (node c_div ((leaf x) (leaf 3.0))))
!(assertEqual (reduceContinTree (node c_div ((leaf 0) (leaf missing)))) (leaf 0.0))
!(assertEqual (reduceContinTree (node c_add ((node c_add ((leaf x) (leaf z))) (leaf w))))
              (node c_add ((leaf x) (leaf z) (leaf w))))
!(assertEqual (reduceContinTree (node c_add ((leaf w) (node c_add ((leaf x) (leaf z))))))
              (node c_add ((leaf w) (node c_add ((leaf x) (leaf z))))))
!(assertEqual (reduceContinTree (node c_add ((leaf z) (leaf x)))) (node c_add ((leaf x) (leaf z))))
!(assertEqual (reduceContinTree (node c_mul ((leaf x) (leaf 2)))) (node c_mul ((leaf 2.0) (leaf x))))
!(assertEqual (continListLength (schemaFields (schema))) 15)
!(assertEqual (fieldSchemaValid (schema)) True)
!(assertEqual (finalizeContinCandidate (rep) (schemaDefaultInstance (schema))) (reduceContinTree (affine)))
!(assertEqual (continAffineSeed (x z))
              (node c_add ((leaf 0.0) (node c_mul ((leaf 0.0) (leaf x))) (node c_mul ((leaf 0.0) (leaf z))))))
!(assertEqual (continAffineCanonize (node c_mul ((leaf x) (leaf z))) (x z)) (mkCEvalError "UnsupportedAffineForm"))
!(assertEqual (continAffineCanonize (leaf missing) (x z)) (mkCEvalError "UnknownAffineLabel"))

;; Finite folds and identities; failed folds stay trees, not decode failures.
!(assertEqual (reduceContinTree (node c_sin ((leaf 0)))) (leaf 0.0))
!(assertEqual (reduceContinTree (node c_log ((leaf 1)))) (leaf 0.0))
!(assertEqual (reduceContinTree (node c_exp ((leaf 0)))) (leaf 1.0))
!(assertEqual (reduceContinTree (node c_div ((leaf 6) (leaf 3)))) (leaf 2.0))
!(assertEqual (reduceContinTree (node c_add ((leaf 2) (leaf 3) (leaf x)))) (node c_add ((leaf 5.0) (leaf x))))
!(assertEqual (reduceContinTree (node c_add ((leaf x) (leaf 2) (leaf 3)))) (node c_add ((leaf x) (leaf 2.0) (leaf 3.0))))
!(assertEqual (reduceContinTree (node c_mul ((leaf 2) (leaf 3) (leaf x)))) (node c_mul ((leaf 6.0) (leaf x))))
!(assertEqual (reduceContinTree (node c_mul ((leaf 1) (leaf x) (leaf 1)))) (leaf x))
!(assertEqual (reduceContinTree (node c_add ((leaf 0) (leaf x) (leaf 0)))) (leaf x))
!(assertEqual (reduceContinTree (node c_mul ((leaf x) (leaf 0)))) (node c_mul ((leaf x) (leaf 0.0))))
!(assertEqual (reduceContinTree (node c_mul ((leaf 1e-300) (leaf 1e-300) (leaf unknown)))) (leaf 0.0))
!(assertEqual (continEval (reduceContinTree (node c_mul ((leaf 1e308) (leaf 1e308) (leaf 0)))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (reduceContinTree (node c_add ((leaf 1e308) (leaf 1e308) (leaf -1e308)))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (reduceContinTree (node c_div ((leaf 1) (leaf 0)))) ()) (mkCEvalError "DivisionByZero"))
!(assertEqual (continEval (reduceContinTree (node c_log ((leaf -1)))) ()) (mkCEvalError "LogNonPositive"))
!(assertEqual (continEval (reduceContinTree (node c_exp ((leaf 1000)))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (reduceContinTree (leaf (py-call (builtins.float "inf")))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (reduceContinTree (node c_mul ((node c_mul ((leaf x) (leaf z))) (leaf w)))) (node c_mul ((leaf x) (leaf z) (leaf w))))
!(assertEqual (reduceContinTree (node c_mul ((leaf w) (node c_mul ((leaf x) (leaf z)))))) (node c_mul ((leaf w) (node c_mul ((leaf x) (leaf z))))))
!(assertEqual (reduceContinTree (node c_div ((leaf x) (leaf -2)))) (node c_mul ((leaf -0.5) (leaf x))))
!(assertEqual (reduceContinTree (node c_div ((leaf x) (leaf 1)))) (leaf x))
!(assertEqual (reduceContinTree (node c_div ((leaf x) (leaf 1e-320)))) (node c_div ((leaf x) (leaf 1e-320))))
!(assertEqual (reduceContinTree (node c_div ((leaf 0)))) (node c_div ((leaf 0.0))))
!(assertEqual (reduceContinTree (node c_sin ((leaf 0) (leaf 1)))) (node c_sin ((leaf 0.0) (leaf 1.0))))
!(assertEqual (reduceContinTree malformed) (mkCEvalError "InvalidMaterializedTree"))
!(assertEqual (reduceContinTree (mkTree (mkCTK (defaultContinSpec 0) 0) ())) (mkCEvalError "InvalidMaterializedTree"))
!(assertEqual (reduceContinTree (node c_mul ((leaf 0) malformed))) (mkCEvalError "InvalidMaterializedTree"))
!(assertEqual (reduceContinTree (node c_add ((leaf "z") (leaf "x")))) (node c_add ((leaf "x") (leaf "z"))))
!(assertEqual (reduceContinTree (node c_add ((leaf "x") (leaf x)))) (node c_add ((leaf x) (leaf "x"))))

;; Verify exact numerical/error preservation and idempotence over a matrix of
;; finite, huge, tiny and missing-input environments. Signed zero is numerical
;; zero in this domain. Empty scaffold identities are a separate explicit policy.
(= (sameNumericalResult $a $b)
   (case ($a $b)
     ((((mkCEvalOk $x) (mkCEvalOk $y)) (and (<= $x $y) (>= $x $y)))
      ($errors (== $a $b)))))
(= (reductionCases)
   ((node c_add ((leaf x) (leaf 0)))
    (node c_add ((leaf x) (leaf 2) (leaf 3)))
    (node c_add ((leaf 2) (leaf 3) (leaf x)))
    (node c_add ((node c_add ((leaf x) (leaf z))) (leaf w)))
    (node c_add ((leaf x) (node c_add ((leaf z) (leaf w)))))
    (node c_add ((leaf 1e308) (node c_add ((leaf -1e308) (leaf x)))))
    (node c_add ((node c_add ((leaf 1e308) (leaf -1e308))) (leaf x)))
    (node c_add ((leaf z) (leaf x)))
    (node c_mul ((leaf x) (leaf 1)))
    (node c_mul ((leaf x) (leaf 0)))
    (node c_mul ((leaf 0) (leaf unknown)))
    (node c_mul ((leaf x) (leaf 0) (node c_log ((leaf -1)))))
    (node c_mul ((leaf 1e308) (leaf 1e308) (leaf 0)))
    (node c_mul ((leaf 1e-300) (leaf 1e-300) (leaf unknown)))
    (node c_mul ((node c_mul ((leaf x) (leaf z))) (leaf w)))
    (node c_mul ((leaf x) (node c_mul ((leaf z) (leaf w)))))
    (node c_mul ((leaf x) (leaf 2)))
    (node c_div ((leaf x) (leaf 2)))
    (node c_div ((leaf x) (leaf -2)))
    (node c_div ((leaf x) (leaf 3)))
    (node c_div ((leaf x) (leaf 1e-320)))
    (node c_div ((leaf 0) (node c_exp ((leaf 1000)))))
    (node c_div ((leaf x) (leaf 0)))
    (node c_log ((node c_add ((leaf x) (leaf 0)))))
    (node c_exp ((node c_mul ((leaf x) (leaf 1)))))
    (node c_sin ((node c_mul ((leaf 1) (leaf x)))))
    (node c_sin ((leaf 0) (leaf x)))
    (node unknownOp ((leaf x)))))
(= (checkReductionCases $trees $env)
   (case $trees
     ((() True)
      ((cons $tree $rest)
       (let $reduced (reduceContinTree $tree)
         (if (and (== $reduced (reduceContinTree $reduced))
                  (sameNumericalResult (continEval $tree $env) (continEval $reduced $env)))
             (checkReductionCases $rest $env) False))))))
!(assertEqual (continListLength (reductionCases)) 28)
!(assertEqual (checkReductionCases (reductionCases) ((mkContinBinding x 2) (mkContinBinding z 3) (mkContinBinding w 4))) True)
!(assertEqual (checkReductionCases (reductionCases) ((mkContinBinding x 0) (mkContinBinding z 0) (mkContinBinding w 0))) True)
!(assertEqual (checkReductionCases (reductionCases) ((mkContinBinding x 1e308) (mkContinBinding z -1e308) (mkContinBinding w 1e-300))) True)
!(assertEqual (checkReductionCases (reductionCases) ((mkContinBinding x 1e-320) (mkContinBinding z 1e-300) (mkContinBinding w 1e308))) True)
!(assertEqual (checkReductionCases (reductionCases) ()) True)

;; Affine scaffolding: every feature remains searchable after reduction, even
;; when the reduced exemplar is just a constant or lone input label.
(= (repTree (mkRep $map $tree)) $tree)
(= (atValue $values $index $value)
   (continAppend (continTake $values $index) (cons $value (continDrop $values (+ $index 1)))))
(= (affineRep $tree) (buildAffineRepresentation $tree (ctx) 1.0 2.0 2))
(= (constantRep) (affineRep (leaf 1)))
(= (constantSchema) (continFieldSchema (constantRep)))
!(assertEqual (affineSeedFromContext (ctx)) (continAffineSeed (x z)))
!(assertEqual (continListLength (schemaFields (constantSchema))) 6)
!(assertEqual (schemaDefaultInstance (constantSchema)) (mkInst (0 0 0 0 0 0)))
!(assertEqual (materializeContinCandidate (constantRep) (schemaDefaultInstance (constantSchema)))
              (node c_add ((leaf 1.0) (node c_mul ((leaf 0.0) (leaf x))) (node c_mul ((leaf 0.0) (leaf z))))))
!(assertEqual (finalizeContinCandidate (constantRep) (schemaDefaultInstance (constantSchema))) (leaf 1.0))
!(assertEqual (finalizeContinCandidate (constantRep) (mkInst (0 0 2 0 0 0))) (node c_add ((leaf 1.0) (leaf x))))
!(assertEqual (finalizeContinCandidate (constantRep) (mkInst (0 0 0 0 2 0))) (node c_add ((leaf 1.0) (leaf z))))
!(assertEqual (fieldOwner (continAt (schemaFields (constantSchema)) 2)) (mkNodeId (2 1)))
!(assertEqual (continSpecMean (fieldSpec (continAt (schemaFields (constantSchema)) 2))) 0.0)
!(assertEqual (continSpecMean (fieldSpec (continAt (schemaFields (constantSchema)) 4))) 0.0)
!(assertEqual (finalizeContinCandidate (rep) (mkInst (0 0 0 0 0 2 1 0 0 0 0 0 0 0 0)))
              (node c_add ((leaf 1.0) (node c_mul ((leaf 2.5) (leaf x))))))
(= (recentered)
   (defaultAffineRepresentation (finalizeContinCandidate (rep) (mkInst (0 0 0 0 0 2 1 0 0 0 0 0 0 0 0))) (ctx)))
!(assertEqual (continSpecMean (fieldSpec (continAt (schemaFields (continFieldSchema (recentered))) 5))) 2.5)
!(assertEqual (finalizeContinCandidate (recentered) (schemaDefaultInstance (continFieldSchema (recentered))))
              (node c_add ((leaf 1.0) (node c_mul ((leaf 2.5) (leaf x))))))
!(assertEqual (== (rep) (recentered)) False)
!(assertEqual (continListLength (schemaFields (continFieldSchema (affineRep (leaf x))))) 6)
!(assertEqual (finalizeContinCandidate (affineRep (leaf x)) (mkInst (0 0 0 0 0 0))) (leaf x))
!(assertEqual (continAffineCanonize (node c_add ((leaf x) (leaf z) (leaf 2))) (x z))
              (node c_add ((node c_mul ((leaf 1.0) (leaf x))) (node c_mul ((leaf 1.0) (leaf z))) (leaf 2.0))))
!(assertEqual (continAffineCanonize (node c_add ((leaf z) (leaf x) (leaf w))) (x z w))
              (node c_add ((node c_mul ((leaf 1.0) (leaf z))) (node c_mul ((leaf 1.0) (leaf x))) (node c_mul ((leaf 1.0) (leaf w))) (leaf 0.0))))
!(assertEqual (continAffineCanonize (leaf "feature name") ("feature name"))
              (node c_add ((node c_mul ((leaf 1.0) (leaf "feature name"))) (leaf 0.0))))
!(assertEqual (continAffineSeed ()) (node c_add ((leaf 0.0))))
!(assertEqual (continListLength (schemaFields (continFieldSchema
                (defaultAffineRepresentation (leaf 2) (mkContinCtx (mkITable ((2 2)) (y)) squared_error 0 linear 0))))) 5)
!(assertEqual (continAffineCanonize (node c_add ((leaf x) (leaf x))) (x z)) (mkCEvalError "RepeatedAffineFeature"))
!(assertEqual (continAffineCanonize (node c_add ((leaf 2) (leaf x) (leaf 3))) (x z)) (mkCEvalError "RepeatedAffineBias"))
!(assertEqual (continAffineCanonize (node c_add ((leaf x) (node c_add ((leaf z) (leaf 1))))) (x z)) (mkCEvalError "UnsupportedAffineForm"))
!(assertEqual (continAffineCanonize (node c_div ((leaf x) (leaf 3))) (x z)) (mkCEvalError "UnsupportedAffineForm"))
!(assertEqual (continAffineCanonize (node c_sin ((leaf x))) (x z)) (mkCEvalError "UnsupportedAffineForm"))
!(assertEqual (continAffineCanonize (node c_mul ((leaf 2) (node c_add ((leaf x) (leaf 1))))) (x z)) (mkCEvalError "UnsupportedAffineForm"))
!(assertEqual (continAffineCanonize (leaf y) (x z)) (mkCEvalError "UnknownAffineLabel"))
!(assertEqual (continAffineCanonize (leaf 0) (x x)) (mkCEvalError "InvalidAffineLabels"))
!(assertEqual (continAffineCanonize (leaf 0) (c_add)) (mkCEvalError "InvalidAffineLabels"))
!(assertEqual (continAffineCanonize (leaf (py-call (builtins.float "inf"))) (x)) (mkCEvalError "NonFinite"))
!(assertEqual (defaultAffineRepresentation (leaf 0) (mkContinCtx (mkITable ((1) (2)) (x y)) squared_error 0 nonlinear 0)) (mkCEvalError "UnsupportedContinuousSearchMode"))
!(assertEqual (defaultAffineRepresentation (leaf 0) badContext) (mkCEvalError "InvalidContext"))
!(assertEqual (defaultAffineRepresentation (leaf 0) (mkContinCtx (mkITable (() ()) (x y)) squared_error 0 linear 0)) (mkCEvalError "InvalidTable"))
!(assertEqual (buildAffineRepresentation (leaf 0) (ctx) 1 2 0) (mkCEvalError "InvalidContinSpec"))

;; Reduced phenotype cache keys and complexity are used by the DEFAULT service.
(= (pending $values) (mkEvaluatedCandidate (mkInst $values) () () candidatePending))
(= (summary $batch)
   ((continListLength (batchEvaluated $batch)) (continListLength (batchPending $batch))
    (batchActualEvaluations $batch) (batchCacheHits $batch) (batchDecodeFailures $batch)))
(= (zeroContext) (mkContinCtx (mkITable ((0 1 2) (0 0 0)) (x y)) squared_error 0.1 linear 0))
(= (zeroRep) (buildAffineRepresentation (leaf 0) (zeroContext) 1 2 2))
!(resetCandidateScoreCache)
!(bind! &zeroBatch (new-state (evaluateCandidateBatch ((pending (0 2 0 1))) (zeroRep) zeroId (zeroContext) 1)))
!(assertEqual (summary (get-state &zeroBatch)) (1 0 1 0 0))
!(assertEqual (candidateTree (car-atom (batchEvaluated (get-state &zeroBatch)))) (leaf 0.0))
!(assertEqual (candidateScore (car-atom (batchEvaluated (get-state &zeroBatch)))) (mkCscore 0.0 1 0.1 0.0 -0.1))
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 0)))
                (buildContinRepresentation (leaf 0) 1 2 2) differentRepId (zeroContext) 0)) (1 0 0 1 0))
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 0 0 0)))
                (buildContinRepresentation (node c_mul ((leaf 0) (node c_log ((leaf -1))))) 1 2 2) skippedId (zeroContext) 0)) (1 0 0 1 0))
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 0)))
                (buildContinRepresentation (node c_log ((leaf -1))) 1 2 2) invalidId (zeroContext) 0)) (0 1 0 0 0))
!(bind! &invalidBatch (new-state (evaluateCandidateBatch ((pending (0 0)) (pending (0 0)))
                 (buildContinRepresentation (node c_log ((leaf -1))) 1 2 2) invalidId (zeroContext) 1)))
!(assertEqual (summary (get-state &invalidBatch)) (2 0 1 1 0))
!(assertEqual (candidateStatus (car-atom (batchEvaluated (get-state &invalidBatch)))) (candidateInvalid "LogNonPositive"))
!(resetCandidateScoreCache)
(= (repA) (buildContinRepresentation (node c_mul ((leaf 2) (leaf x))) 1 2 2))
(= (repB) (buildContinRepresentation (node c_add ((node c_mul ((leaf x) (leaf 2))) (leaf 0))) 1 2 2))
!(assertEqual (finalizeContinCandidate (repA) (mkInst (0 0))) (finalizeContinCandidate (repB) (mkInst (0 0 0 0))))
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 0))) (repA) a (ctx) 1)) (1 0 1 0 0))
!(assertEqual (summary (evaluateCandidateBatch ((pending (0 0 0 0))) (repB) b (ctx) 0)) (1 0 0 1 0))
!(assertEqual (collapse (finalizeContinCandidate (repB) (mkInst (0 0 0 0)))) ((node c_mul ((leaf 2.0) (leaf x)))))

;; Exhaustive affine rebuild gate: 7 canonical depth-two slices per coefficient,
;; three coefficients (bias,x,z) -> 343 distinct genotypes. Every reduced form
;; must rebuild with six fields and the same default phenotype/predictions.
(= (affinePrependSlices $slice $tails)
   (case $tails ((() ()) ((cons $tail $rest) (cons (continAppend $slice $tail) (affinePrependSlices $slice $rest))))))
(= (affineCrossSlices $slices $tails)
   (case $slices ((() ()) ((cons $slice $rest) (continAppend (affinePrependSlices $slice $tails) (affineCrossSlices $rest $tails))))))
(= (affineVectors $n)
   (if (== $n 0) (()) (affineCrossSlices ((0 0) (1 0) (1 1) (1 2) (2 0) (2 1) (2 2)) (affineVectors (- $n 1)))))
(= (allAffineRebuilds $vectors $source $environment)
   (case $vectors
     ((() True)
      ((cons $values $rest)
       (let* (($instance (mkInst $values))
              ($raw (materializeContinCandidate $source $instance))
              ($reduced (finalizeContinCandidate $source $instance))
              ($rebuilt (affineRep $reduced))
              ($rebuiltSchema (continFieldSchema $rebuilt))
              ($defaultTree (finalizeContinCandidate $rebuilt (schemaDefaultInstance $rebuiltSchema))))
         (if (and (== (continListLength (schemaFields $rebuiltSchema)) 6)
                  (and (== $reduced $defaultTree)
                       (sameNumericalResult (continEval $raw $environment) (continEval $reduced $environment))))
             (allAffineRebuilds $rest $source $environment) False))))))
!(assertEqual (continListLength (affineVectors 3)) 343)
!(assertEqual (allAffineRebuilds (affineVectors 3) (affineRep (affine)) ((mkContinBinding x 2) (mkContinBinding z 3))) True)
!(assertEqual (allAffineRebuilds (affineVectors 3) (affineRep (affine)) ((mkContinBinding x -4) (mkContinBinding z 0))) True)
!(assertEqual (allAffineRebuilds (affineVectors 3) (affineRep (affine)) ((mkContinBinding x 1e308) (mkContinBinding z -1e308))) True)
!(assertEqual (reduceContinTree (node c_div ((leaf x) (leaf (py-call (math.ldexp 1.0 -1074))))))
              (node c_div ((leaf x) (leaf (py-call (math.ldexp 1.0 -1074))))))
!(assertEqual (sameNumericalResult
                (continEval (node c_div ((leaf x) (leaf (py-call (math.ldexp 1.0 1023))))) ((mkContinBinding x 1e308)))
                (continEval (reduceContinTree (node c_div ((leaf x) (leaf (py-call (math.ldexp 1.0 1023)))))) ((mkContinBinding x 1e308)))) True)
