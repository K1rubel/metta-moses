(= (hSchema) (mkFieldSchema ((mkField 0 2 0 a discrete 0 0 ()) (mkField 1 2 0 b discrete 0 1 ()))))
(= (hRow $values) (mkEvaluatedCandidate (mkInst $values) () () candidateValid))
(= (hDependent) (List.concat (List.repeat 32 (hRow (0 0))) (List.repeat 32 (hRow (1 1)))))
(= (hCfg) (mkHConfig 3 3 8 2 16 256 100.0 True))
(= (hGraph (mkHBOAModel $nodes $order $alpha $stats)) (hboaGraph $nodes))
(= (hOrder (mkHBOAModel $nodes $order $alpha $stats)) $order)
(= (hStats (mkHBOAModel $nodes $order $alpha $stats)) $stats)
(= (hFit $rows $cfg) (hboaFit (hSchema) $rows 1.0 $cfg -1))
!(assertEqual (hboaConfigValid (hCfg)) True)
!(assertEqual (hboaConfigValid (mkHConfig -1 3 8 2 16 256 10 True)) False)
!(assertEqual (hboaConfigValid (mkHConfig 3 3 0 2 16 256 10 True)) False)
!(assertEqual (hboaConfigValid (mkHConfig 3 3 8 0 16 256 10 True)) False)
!(assertEqual (hboaConfigValid (mkHConfig 3 3 8 2 16 256 10 bad)) False)
!(assertEqual (hboaConfigValid (mkHConfig 3 3 8 2 16 256 -1 True)) False)
!(bind! &hLearned (new-state (hFit (hDependent) (hCfg))))
!(assertEqual (hGraph (get-state &hLearned)) ((1) ()))
!(assertEqual (hOrder (get-state &hLearned)) (1 0))
!(assertEqual (edaModelSize (get-state &hLearned)) 3)
!(assertEqual (let (mkHBOAModel $nodes $order $alpha $stats) (get-state &hLearned)
  (hboaTree (car-atom $nodes))) (mkHSplit 1 0 (mkHLeaf (32 0)) (mkHLeaf (0 32))))
!(assertEqual (hboaSample (hSchema) (get-state &hLearned) 1) (mkLegalSample (mkInst (0 0)) 182605794))
!(assertEqual (hGraph (hFit () (hCfg))) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 0 3 8 2 16 256 100 True))) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 3 0 8 2 16 256 100 True))) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 3 3 1 2 16 256 100 True))) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 3 3 8 33 16 256 100 True))) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 3 3 8 2 0 256 100 True))) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 3 3 8 2 16 0 100 True))) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 3 3 8 2 16 256 0 True))) (() ()))
!(assertEqual (hGraph (hboaFit (hSchema) (hDependent) 1.0 (hCfg) 0)) (() ()))
!(assertEqual (hGraph (hFit (hDependent) (mkHConfig 3 3 8 2 16 256 100 False))) (() ()))
!(assertEqual (hboaEdgeLegal (() (0) ()) (() () (1)) 2 0 3) False)
!(assertEqual (hboaEdgeLegal (() (0) ()) (() () ()) 1 0 3) False)
!(assertEqual (hboaEdgeLegal (() (0) ()) (() () ()) 0 1 3) True)
!(assertEqual (hboaEdgeLegal (() ()) ((1) ()) 1 0 1) True)
!(assertEqual (hboaEdgeLegal (() ()) (() ()) 0 0 3) False)
(= (hIndependent) (List.concat (List.repeat 16 (hRow (0 0)))
  (List.concat (List.repeat 16 (hRow (0 1)))
    (List.concat (List.repeat 16 (hRow (1 0))) (List.repeat 16 (hRow (1 1)))))))
!(assertEqual (hGraph (hFit (hIndependent) (hCfg))) (() ()))
(= (hDraws $schema $model $left $rng)
  (if (== $left 0) ()
    (let (mkLegalSample $inst $next) (hboaSample $schema $model $rng)
      (cons $inst (hDraws $schema $model (- $left 1) $next)))))
!(bind! &hDrawn (new-state (hDraws (hSchema) (get-state &hLearned) 200 98765)))
!(assertEqual (> (List.length (filter-atom (get-state &hDrawn) (mkInst ($a $b)) (== $a $b))) 180) True)
(= (hContin) (mkFieldSchema (List.concat
  (continFieldSlice c (mkContinSpec 0.0 1.0 2.0 2) 0 0) ((mkField 2 2 0 d discrete 0 2 ())))))
(= (hMaskedRows) ((hRow (0 0 0)) (hRow (0 0 1)) (hRow (1 0 1)) (hRow (2 1 0))))
(= (hViews) (map-atom (hMaskedRows) $row (instanceModelView (hContin) (candidateInstance $row))))
!(assertEqual (hboaRoot (schemaFields (hContin)) (hViews) 1) (mkHNode 1 () (mkHLeaf (1 1 0)) 2))
!(assertEqual (hboaWeights (mkHSplit 1 -1 (mkHLeaf (2 0)) (mkHLeaf (0 2))) (0 -1 0) 1.0) (3.0 1.0))
!(assertEqual (hboaWeights (mkHSplit 1 -1 (mkHLeaf (2 0)) (mkHLeaf (0 2))) (1 0 0) 1.0) (1.0 3.0))
!(assertEqual (hboaWeights (mkHLeaf (0 0 0)) () 1.0) (1.0 1.0 1.0))
!(bind! &hContinModel (new-state (hboaFit (hContin) (hMaskedRows) 1.0 (hCfg) -1)))
!(assertEqual (all (map-atom (hDraws (hContin) (get-state &hContinModel) 200 17)
  $inst (== (canonicalizeInstance (hContin) $inst) $inst))) True)
!(assertEqual (hboaSample (mkFieldSchema ()) (hboaFit (mkFieldSchema ()) () 1.0 (hCfg) -1) 1)
  (mkLegalSample (mkInst ()) 1))
;; Context-specific AND: target field 0 only depends on field 2 when field 1=1.
(= (hContextSchema) (mkFieldSchema
  ((mkField 0 2 0 y discrete 0 0 ()) (mkField 1 2 0 a discrete 0 1 ()) (mkField 2 2 0 b discrete 0 2 ()))))
(= (hContextRows) (List.concat (List.repeat 32 (hRow (0 0 0)))
  (List.concat (List.repeat 32 (hRow (0 0 1)))
    (List.concat (List.repeat 32 (hRow (0 1 0))) (List.repeat 32 (hRow (1 1 1)))))))
!(bind! &hContext (new-state (hboaFit (hContextSchema) (hContextRows) 1.0 (hCfg) -1)))
!(assertEqual (let (mkHBOAModel $nodes $order $alpha $stats) (get-state &hContext)
  (car-atom $nodes)) (mkHNode 0 (1 2)
    (mkHSplit 1 0 (mkHLeaf (64 0)) (mkHSplit 2 0 (mkHLeaf (32 0)) (mkHLeaf (0 32)))) 128))
!(assertEqual (edaModelSize (get-state &hContext)) 5)
!(assertEqual (let (mkHBOAModel $nodes $order $alpha $stats)
  (hboaFit (hContextSchema) (hContextRows) 1.0 (mkHConfig 3 1 8 2 16 256 100 True) -1)
  (all (map-atom $nodes $node (all (map-atom (hboaLeaves (hboaTree $node) ()) ($path $counts)
    (<= (List.length $path) 1)))))) True)
!(assertEqual (let (mkHBOAModel $nodes $order $alpha $stats)
  (hboaFit (hContextSchema) (hContextRows) 1.0 (mkHConfig 3 3 2 2 16 256 100 True) -1)
  (all (map-atom $nodes $node (<= (List.length (hboaLeaves (hboaTree $node) ())) 2)))) True)
!(assertEqual (let (mkHFitStats $sec $edges $params $nodes $leaves $splits $calls $stop)
  (hStats (hFit (hDependent) (mkHConfig 3 3 8 2 16 1 100 True)))
  ($edges $splits $calls $stop)) (1 1 3 fitScoreLimit))
!(assertEqual (let (mkHFitStats $sec $edges $params $nodes $leaves $splits $calls $stop)
  (hStats (hFit (hDependent) (mkHConfig 3 3 8 2 1 256 100 True)))
  ($edges $splits $stop)) (1 1 fitIterationLimit))
!(assertEqual (let (mkHFitStats $sec $edges $params $nodes $leaves $splits $calls $stop)
  (hStats (hFit (hDependent) (mkHConfig 3 3 8 2 16 256 0 True))) $stop) fitTime)
!(assertEqual (let (mkHFitStats $sec $edges $params $nodes $leaves $splits $calls $stop)
  (hStats (hFit (hDependent) (mkHConfig 3 3 8 2 16 256 100 False)))
  ($edges $calls $stop)) (0 2 fitDependenciesDisabled))
;; No-dependency control has EXACTLY the univariate draw stream (same order,
;; masked counts, alpha, and RNG), not a separate distribution or STOP policy.
!(assertEqual (hboaSample (hContin)
  (hboaFit (hContin) (hMaskedRows) 1.0 (mkHConfig 3 3 8 2 16 256 100 False) -1) 42)
  (edaSampleUnivariate (hContin) (edaFitUnivariate (hContin) (hMaskedRows) 1.0) 42))
;; RTR uses scores of already evaluated rows; never invokes a scorer.
(= (hTernary) (mkFieldSchema ((mkField 0 3 0 y discrete 0 0 ()) (mkField 1 3 0 x discrete 0 1 ()))))
(= (hTernaryRows) (List.concat (List.repeat 40 (hRow (0 0)))
  (List.concat (List.repeat 40 (hRow (1 1))) (List.repeat 40 (hRow (2 2))))))
!(bind! &hTernaryModel (new-state (hboaFit (hTernary) (hTernaryRows) 1.0
  (mkHConfig 1 3 8 2 16 256 100 True) -1)))
!(assertEqual (let (mkHBOAModel $nodes $order $alpha $stats) (get-state &hTernaryModel)
  (car-atom $nodes)) (mkHNode 0 (1) (mkHSplit 1 0 (mkHLeaf (40 0 0))
    (mkHSplit 1 1 (mkHLeaf (0 40 0)) (mkHLeaf (0 0 40)))) 120))
!(assertEqual (edaModelSize (get-state &hTernaryModel)) 8)
!(assertEqual (all (map-atom (hDraws (hTernary) (get-state &hTernaryModel) 100 42)
  $inst (== (canonicalizeInstance (hTernary) $inst) $inst))) True)
(= (hScored $values $score $comp)
  (mkEvaluatedCandidate (mkInst $values) () (mkCscore $score $comp 0 0 $score) candidateValid))
(= (hPop) ((hScored (0 0) 10 1) (hScored (1 1) 0 1)))
!(assertEqual (edaHamming (mkInst (0 0 1)) (mkInst (1 0 2))) 2)
!(assertEqual (edaClosest (hPop) (hScored (1 0) 5 1) (1 0)) 1)
!(assertEqual (let ($p $r $accepted) (edaRTR (hPop) ((hScored (1 1) 5 1)) 2 99 1 0)
  ($p $accepted)) (((hScored (0 0) 10 1) (hScored (1 1) 5 1)) 1))
!(assertEqual (let ($p $r $accepted) (edaRTR (hPop) ((hScored (0 0) 9 1)) 2 99 1 0)
  ($p $accepted)) ((hPop) 0))
!(assertEqual (let ($p $r $accepted) (edaRTR (hPop) ((hScored (1 1) 0 1)) 2 99 1 0)
  ($p $accepted)) ((hPop) 0))
!(assertEqual (let ($p $r $accepted) (edaRTR (hPop) ((hScored (1 1) 0 0)) 2 99 1 0)
  ($p $accepted)) (((hScored (0 0) 10 1) (hScored (1 1) 0 0)) 1))
!(assertEqual (edaWindow (0 1 2) 99 1) ((0 2 1) 1291394886))
!(assertEqual (edaWindow () 8 1) (() 1))
!(assertEqual (let ($p $r $a) (edaRTR () ((hScored (0 0) 1 1)) 2 8 1 0)
  ($p $r $a)) (((hScored (0 0) 1 1)) 1 1))
;; A raw champion may lose on penalized fitness; it still lives in archive.
(= (hRawChampion) (mkEvaluatedCandidate (mkInst (1 0)) () (mkCscore 20 9 30 0 -10) candidateValid))
!(assertEqual (edaRawBest (List.append (hRawChampion) (hPop))) (hRawChampion))
!(assertEqual (let ($p $r $a) (edaRTR (hPop) ((hRawChampion)) 2 8 1 0) $p) (hPop))
!(set-param edaReplacement rtr)
!(assertEqual (edaReplacementStep boaSample (hPop) ((hScored (1 1) 5 1)) 2 1)
  (let ($p $r $a) (edaRTR (hPop) ((hScored (1 1) 5 1)) 2 8 1 0) ($p $r)))
!(set-param edaReplacement auto)
!(assertEqual (edaReplacementStep boaSample (hPop) ((hScored (1 1) 5 1)) 2 1)
  (((hScored (0 0) 10 1) (hScored (1 1) 5 1)) 1))
!(set-param edaRTRWindow 0)
!(assertEqual (edaReplacementValid) False)
!(set-param edaRTRWindow 8)
!(set-param edaReplacement bad)
!(assertEqual (edaReplacementValid) False)
!(set-param edaReplacement auto)
;; Actual continuous scorer/cache boundary, including zero/tiny budgets and
;; replay. Force a small population so these fixtures exercise model fitting.
(= (hContextScore) (mkContinCtx (mkITable ((-1.0 0.0 1.0) (-1.0 0.0 1.0)) ("x" "y")) squared_error 0.0 linear 0.0))
(= (hRep) (buildAffineRepresentation (mkTree (mkNode 0.0) ()) (hContextScore) 1.0 2.0 2))
(= (hRun $limits $target)
   (let* (($_cache (resetCandidateScoreCache)) ($_behavior (resetContinBehaviorCache)))
     (optimizeDeme (mkDeme (hRep) (mkSInstSet ()) (mkDemeId "boa"))
       (mkOptimizerContext (hContextScore) $target) (mkInst (0 0 0 0)) $limits 1 (mkOptimizerConfig hboa))))
(= (hSummary $result) ((resultActualEvaluations $result) (resultStopReason $result)
                      (diagProposals (resultDiagnostics $result))))
!(set-param edaPopulationSize 4)
!(set-param edaSelectionSize 8)
!(set-param edaOffspringSize 4)
!(assertEqual (hSummary (hRun (mkOptimizerLimits 0 100 10 -1) 0)) (0 stopBudgetExhausted 0))
!(assertEqual (hSummary (hRun (mkOptimizerLimits 100 0 10 -1) 0)) (0 stopProposalsExhausted 0))
!(assertEqual (hSummary (hRun (mkOptimizerLimits 100 100 0 -1) 0)) (0 stopGenerationsExhausted 0))
!(assertEqual (hSummary (hRun (mkOptimizerLimits 100 100 10 0) 0)) (0 stopTimeExhausted 0))
!(assertEqual (hSummary (hRun (mkOptimizerLimits 1 100 10 -1) 0)) (1 stopBudgetExhausted 1))
!(assertEqual (hSummary (hRun (mkOptimizerLimits 100 1 10 -1) 0)) (1 stopProposalsExhausted 1))
!(assertEqual (resultStopReason (hRun (mkOptimizerLimits 100 1000 2 -1) 1)) stopGenerationsExhausted)
!(bind! &hBoundary (new-state (hRun (mkOptimizerLimits 10 1000 20 -1) 1)))
!(assertEqual (resultActualEvaluations (get-state &hBoundary)) 10)
!(assertEqual (resultStopReason (get-state &hBoundary)) stopBudgetExhausted)
!(assertEqual (> (diagModelSize (resultDiagnostics (get-state &hBoundary))) 0) True)
!(assertEqual (hRun (mkOptimizerLimits 10 1000 20 -1) 1) (get-state &hBoundary))
!(assertEqual (resultStopReason (hRun (mkOptimizerLimits 100 10000 100 -1) 0)) stopTargetReached)
!(assertEqual (case (hRun (mkOptimizerLimits -2 1000 20 -1) 1)
  (((Error $v $reason) True) ($other False))) True)
