;; Diagnostic-only fixed representation, NOT a symbolic-regression workload.
;; Uses the existing action fitness callback seam: each optional one leaf is
;; enclosed in a fixed bit slot, so decoding is bijective and scoring is counted.
(= (linkKnob) (mkASK (mkDiscKnob (mkMultip 2) (mkDiscSpec 0) (mkDiscSpec 0) ())
  ((mkTree (mkNode one) ()))))
(= (linkRep $n)
  (let $indices (fieldPriorIndices 0 $n)
    (mkRep (mkKbMap (mkDscMp (map-atom $indices $i ((mkDiscSpec 2) (linkKnob)))))
      (mkTree (mkNode vector)
        (map-atom $indices $i (mkTree (mkNode bit)
          ((mkKnob (mkNullVex ((mkTree (mkNode one) ()))) (linkKnob) $i))))))))
(= (linkTrap $bits)
  (if (== $bits ()) 0
    (let $ones (List.sum (List.takeN 3 $bits))
      (+ (if (== $ones 3) 3 (- 2 $ones)) (linkTrap (List.drop 3 $bits))))))
(= (linkHIFF $bits)
  (let $n (List.length $bits)
    (if (== $n 1) 1
      (+ (if (all (map-atom $bits $b (== $b (car-atom $bits)))) $n 0)
        (+ (linkHIFF (List.takeN (/ $n 2) $bits)) (linkHIFF (List.drop (/ $n 2) $bits)))))))
!(bind! &linkCalls (new-state 0))
!(bind! &linkStart (new-state 0))
(= (linkFitness (vector $slots) $episode)
  (let* (($bits (map-atom $slots (bit $children) (if (== $children ()) 0 1)))
         ($score (if (== (param problem) trap12) (linkTrap $bits) (linkHIFF $bits)))
         ($index (+ 1 (get-state &linkCalls)))
         ($_count (change-state! &linkCalls $index))
         ($_trace (println! (LinkageEvaluation (scorerCallIndex $index)
           (elapsed (- (candidateNow) (get-state &linkStart))) (bits $bits) (raw $score))))) $score))
!(apply-cli-overrides)
!(set-param fitness linkFitness)
!(set-param diagnostics True)
!(let* (($trap (== (param problem) trap12)) ($n (if $trap 12 8))
        ($target (if $trap 12 32))
        ($initial (mkInst (if $trap (List.repeat $n 0) (0 1 0 1 0 1 0 1))))
        ($_validate (optimizer-for (param optAlgo)))
        ($_cache (resetCandidateScoreCache)) ($_action (resetActionScoreCache))
        ($_time (change-state! &linkStart (candidateNow)))
        ($result (optimizeDeme (mkDeme (linkRep $n) (mkSInstSet ()) (mkDemeId "linkage"))
          (mkActionCtx 1 0 $target) $initial
          (mkOptimizerLimits (param maxEvals) (param optimizerMaxProposals)
            (param optimizerMaxGenerations) (param optimizerTimeLimitSec))
          (optimizerRngFromSeed (param seed)) (mkOptimizerConfig (param optAlgo))))
        ((mkDeme $rep (mkSInstSet $rows) $id) (resultDeme $result)))
  (println! (LinkageResult (actualEvaluations (resultActualEvaluations $result))
    (stop (resultStopReason $result)) (proposals (diagProposals (resultDiagnostics $result)))
    (cacheHits (diagCacheHits (resultDiagnostics $result))) (invalids (diagInvalids (resultDiagnostics $result)))
    (rows (map-atom $rows (mkSInst (mkPair (mkInst $bits) $score)) ($bits (getScore $score)))))))
