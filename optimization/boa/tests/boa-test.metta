(= (bSchema) (mkFieldSchema
  ((mkField 0 2 0 a discrete 0 0 ()) (mkField 1 2 0 b discrete 0 1 ()))))
(= (bRow $values) (mkEvaluatedCandidate (mkInst $values) () () candidateValid))
(= (bDependent) (List.concat (List.repeat 32 (bRow (0 0))) (List.repeat 32 (bRow (1 1)))))
(= (bIndependent) (List.concat (List.repeat 16 (bRow (0 0)))
  (List.concat (List.repeat 16 (bRow (0 1)))
    (List.concat (List.repeat 16 (bRow (1 0))) (List.repeat 16 (bRow (1 1)))))))
(= (bCfg) (mkBOAConfig 2 256 16 256 100.0))
(= (bGraph (mkBOAModel $nodes $order $alpha $stats)) (boaLearnedGraph $nodes))
(= (bOrder (mkBOAModel $nodes $order $alpha $stats)) $order)
(= (bStats (mkBOAModel $nodes $order $alpha $stats)) $stats)
(= (bFit $rows $cfg) (boaFit (bSchema) $rows 1.0 $cfg -1))
!(assertEqual (boaConfigValid (bCfg)) True)
!(assertEqual (boaConfigValid (mkBOAConfig -1 256 16 256 10.0)) False)
!(assertEqual (boaConfigValid (mkBOAConfig 2 0 16 256 10.0)) False)
!(assertEqual (boaConfigValid (mkBOAConfig 2 256 bad 256 10.0)) False)
!(assertEqual (boaConfigValid (mkBOAConfig 2 256 16 256 -1)) False)
!(assertEqual (boaConfigValid (mkBOAConfig 0 1 0 0 0)) True)
!(assertEqual (boaTopological (() (0) (0 1))) (0 1 2))
!(assertEqual (boaTopological ((1) (0))) (Error ((1) (0)) "Cyclic BOA graph"))
!(assertEqual (boaEdgeLegal (() (0) ()) (() () (1)) 2 0) False)
!(assertEqual (boaEdgeLegal (() (0) ()) (() () ()) 1 0) False)
!(assertEqual (boaEdgeLegal (() (0) ()) (() () ()) 0 1) True)
!(assertEqual (boaEdgeLegal (() ()) (() ()) 0 0) False)
!(bind! &bLearned (new-state (bFit (bDependent) (bCfg))))
!(assertEqual (bGraph (get-state &bLearned)) ((1) ()))
!(assertEqual (bOrder (get-state &bLearned)) (1 0))
!(assertEqual (edaModelSize (get-state &bLearned)) 3)
!(assertEqual (bGraph (bFit (bIndependent) (bCfg))) (() ()))
!(assertEqual (bGraph (bFit () (bCfg))) (() ()))
!(assertEqual (bGraph (bFit (bDependent) (mkBOAConfig 0 256 16 256 100.0))) (() ()))
!(assertEqual (bGraph (bFit (bDependent) (mkBOAConfig 2 3 16 256 100.0))) (() ()))
!(assertEqual (bGraph (bFit (bDependent) (mkBOAConfig 2 256 0 256 100.0))) (() ()))
!(assertEqual (bGraph (bFit (bDependent) (mkBOAConfig 2 256 16 0 100.0))) (() ()))
!(assertEqual (bGraph (bFit (bDependent) (mkBOAConfig 2 256 16 256 0.0))) (() ()))
!(assertEqual (bGraph (boaFit (bSchema) (bDependent) 1.0 (bCfg) 0)) (() ()))
!(assertEqual (let (mkBOAModel $nodes $order $alpha $stats) (get-state &bLearned)
  (map-atom $nodes $node (boaNodeParameters $node))) (2 1))
!(assertEqual (let (mkBOAModel $nodes $order $alpha $stats) (get-state &bLearned)
  (boaConditionalWeights (car-atom $nodes) (0) $alpha)) (33.0 1.0))
!(assertEqual (let (mkBOAModel $nodes $order $alpha $stats) (get-state &bLearned)
  (boaConditionalWeights (car-atom $nodes) (1) $alpha)) (1.0 33.0))
!(assertEqual (boaSample (bSchema) (get-state &bLearned) 1) (mkLegalSample (mkInst (0 0)) 182605794))
;; Deterministic stream; agreement is a statistical fixture, not a program-quality claim.
(= (bDraws $schema $model $left $rng)
  (if (== $left 0) ()
    (let (mkLegalSample $inst $next) (boaSample $schema $model $rng)
      (cons $inst (bDraws $schema $model (- $left 1) $next)))))
!(bind! &bDrawn (new-state (bDraws (bSchema) (get-state &bLearned) 200 98765)))
!(assertEqual (> (List.length (filter-atom (get-state &bDrawn) (mkInst ($a $b)) (== $a $b))) 180) True)
!(assertEqual (all (map-atom (get-state &bDrawn) $inst (== (canonicalizeInstance (bSchema) $inst) $inst))) True)
(= (bContin) (mkFieldSchema (List.concat
  (continFieldSlice c (mkContinSpec 0.0 1.0 2.0 2) 0 0)
  ((mkField 2 2 0 d discrete 0 2 ())))))
!(assertEqual (boaContexts (schemaFields (bContin)) (List.getByIdx (schemaFields (bContin)) 2) (0 1) 256)
  ((0 -1) (1 0) (1 1) (1 2) (2 0) (2 1) (2 2)))
!(assertEqual (boaContexts (schemaFields (bContin)) (List.getByIdx (schemaFields (bContin)) 1) (0) 256) ((1) (2)))
!(assertEqual (boaContexts (schemaFields (bContin)) (List.getByIdx (schemaFields (bContin)) 2) (1) 256)
  ((-1) (0) (1) (2)))
!(assertEqual (boaContexts (schemaFields (bContin)) (List.getByIdx (schemaFields (bContin)) 2) (0 1) 13) boaTooLarge)
(= (bMaskedRows) ((bRow (0 0 0)) (bRow (0 0 1)) (bRow (1 0 1)) (bRow (2 1 0))))
(= (bViews) (map-atom (bMaskedRows) $row (instanceModelView (bContin) (candidateInstance $row))))
!(assertEqual (map-atom (bViews) $v (boaObservation $v 1)) (-1 -1 0 1))
!(assertEqual (let (mkBOANode $i $ps $t $f $s $k $n)
  (boaFitLocal (schemaFields (bContin)) (bViews) 1 () 1.0 (())) ($t $f $k $n))
  (((() (1 1 0))) (2.0 2.0 1.0) 2 2))
!(assertEqual (let (mkBOANode $i $ps $t $f $s $k $n)
  (boaFitLocal (schemaFields (bContin)) (bViews) 2 (1) 1.0 ((-1) (0) (1) (2))) ($t $k $n))
  ((((-1) (1 1)) ((0) (0 1)) ((1) (1 0)) ((2) (0 0))) 4 4))
!(assertEqual (boaConditionalWeights
  (boaFitLocal (schemaFields (bContin)) (bViews) 2 (1) 1.0 ((-1) (0) (1) (2))) (2) 1.0) (3.0 3.0))
!(assertEqual (boaConditionalWeights
  (boaFitLocal (schemaFields (bContin)) () 1 (0) 1.0 ((1) (2))) (1) 1.0) (1.0 1.0 1.0))
!(assertEqual (boaNodeScore (boaFitLocal (schemaFields (bContin)) () 1 (0) 1.0 ((1) (2)))) 0.0)
!(assertEqual (boaLogLikelihood (0 0 0)) 0.0)
!(assertEqual (< (abs-math (- (boaLogLikelihood (2 2)) -2.772588722239781)) 0.00000001) True)
!(bind! &bContinModel (new-state (boaFit (bContin) (bMaskedRows) 1.0 (bCfg) -1)))
!(assertEqual (all (map-atom (bDraws (bContin) (get-state &bContinModel) 200 17)
  $inst (== (canonicalizeInstance (bContin) $inst) $inst))) True)
!(assertEqual (let* ((($node $cache) (boaCachedLocal (schemaFields (bContin)) (bViews) 2 (1) 1.0 256 (mkBOACache () 0 0)))
                     (($again (mkBOACache $entries $calls $hits))
                       (boaCachedLocal (schemaFields (bContin)) (bViews) 2 (1) 1.0 256 $cache)))
  ($calls $hits (== $node $again))) (1 1 True))

;; A smoothed independent sampler cannot preserve the strong paired linkage.
(= (bIndependentDraws $model $left $rng)
  (if (== $left 0) ()
    (let (mkLegalSample $inst $next) (edaSampleUnivariate (bSchema) $model $rng)
      (cons $inst (bIndependentDraws $model (- $left 1) $next)))))
!(assertEqual (< (List.length (filter-atom
  (bIndependentDraws (edaFitUnivariate (bSchema) (bDependent) 1.0) 200 98765)
  (mkInst ($a $b)) (== $a $b))) 130) True)
;; Heterogeneous fields and nonadjacent continuous parents: an intervening
;; unobserved STOP can make the later parent inactive even if the first is LEFT.
(= (bDeepFields) (List.concat (continFieldSlice c (mkContinSpec 0.0 1.0 2.0 3) 0 0)
  ((mkField 3 4 0 d discrete 0 3 ()))))
!(assertEqual (boaContexts (bDeepFields) (List.getByIdx (bDeepFields) 3) (0 2) 256)
  ((0 -1) (1 -1) (1 0) (1 1) (1 2) (2 -1) (2 0) (2 1) (2 2)))
!(assertEqual (boaNodeParameters (boaFitLocal (bDeepFields) () 3 (0 2) 1.0
  (boaContexts (bDeepFields) (List.getByIdx (bDeepFields) 3) (0 2) 256))) 27)
;; Mask-only dependence is genuine when inactivity is a PARENT, not padding 0.
(= (bActivityRows) (List.concat (List.repeat 32 (bRow (0 0 0)))
  (List.concat (List.repeat 16 (bRow (1 0 1))) (List.repeat 16 (bRow (2 0 1))))))
!(bind! &bActivityModel (new-state (boaFit (bContin) (bActivityRows) 1.0 (bCfg) -1)))
!(assertEqual (> (edaModelSize (get-state &bActivityModel)) 5) True)
!(assertEqual (all (map-atom (bDraws (bContin) (get-state &bActivityModel) 200 17)
  $inst (== (canonicalizeInstance (bContin) $inst) $inst))) True)
!(assertEqual (let (mkBOAFitStats $seconds $edges $k $cells $iterations $scores $hits $stop)
  (bStats (bFit (bDependent) (mkBOAConfig 1 4 1 1 100.0)))
  ($edges $iterations $scores $stop)) (1 1 3 fitScoreLimit))
!(assertEqual (let (mkBOAFitStats $seconds $edges $k $cells $iterations $scores $hits $stop)
  (bStats (bFit (bDependent) (mkBOAConfig 1 4 1 256 100.0)))
  ($edges $iterations $stop)) (1 1 fitIterationLimit))
!(assertEqual (let (mkBOAFitStats $seconds $edges $k $cells $iterations $scores $hits $stop)
  (bStats (bFit (bDependent) (mkBOAConfig 1 4 16 256 0.0))) $stop) fitTime)
!(assertEqual (let (mkBOAModel $nodes $order $alpha $stats) (get-state &bActivityModel)
  (all (map-atom $nodes $node (and (<= (List.length (boaNodeParents $node)) 2)
                                (<= (boaNodeCells $node) 256))))) True)
!(assertEqual (boaSample (mkFieldSchema ()) (boaFit (mkFieldSchema ()) () 1.0 (bCfg) -1) 1)
  (mkLegalSample (mkInst ()) 1))

;; Actual continuous scorer/cache boundary, including zero/tiny budgets and
;; replay. Force a small population so these fixtures exercise model fitting.
(= (bContext) (mkContinCtx (mkITable ((-1.0 0.0 1.0) (-1.0 0.0 1.0)) ("x" "y")) squared_error 0.0 linear 0.0))
(= (bRep) (buildAffineRepresentation (mkTree (mkNode 0.0) ()) (bContext) 1.0 2.0 2))
(= (bRun $limits $target)
   (let* (($_cache (resetCandidateScoreCache)) ($_behavior (resetContinBehaviorCache)))
     (optimizeDeme (mkDeme (bRep) (mkSInstSet ()) (mkDemeId "boa"))
       (mkOptimizerContext (bContext) $target) (mkInst (0 0 0 0)) $limits 1 (mkOptimizerConfig boa))))
(= (bSummary $result) ((resultActualEvaluations $result) (resultStopReason $result)
                      (diagProposals (resultDiagnostics $result))))
!(set-param edaPopulationSize 4)
!(set-param edaSelectionSize 8)
!(set-param edaOffspringSize 4)
!(assertEqual (bSummary (bRun (mkOptimizerLimits 0 100 10 -1) 0)) (0 stopBudgetExhausted 0))
!(assertEqual (bSummary (bRun (mkOptimizerLimits 100 0 10 -1) 0)) (0 stopProposalsExhausted 0))
!(assertEqual (bSummary (bRun (mkOptimizerLimits 100 100 0 -1) 0)) (0 stopGenerationsExhausted 0))
!(assertEqual (bSummary (bRun (mkOptimizerLimits 100 100 10 0) 0)) (0 stopTimeExhausted 0))
!(assertEqual (bSummary (bRun (mkOptimizerLimits 1 100 10 -1) 0)) (1 stopBudgetExhausted 1))
!(assertEqual (bSummary (bRun (mkOptimizerLimits 100 1 10 -1) 0)) (1 stopProposalsExhausted 1))
!(assertEqual (resultStopReason (bRun (mkOptimizerLimits 100 1000 2 -1) 1)) stopGenerationsExhausted)
!(bind! &bBoundary (new-state (bRun (mkOptimizerLimits 10 1000 20 -1) 1)))
!(assertEqual (resultActualEvaluations (get-state &bBoundary)) 10)
!(assertEqual (resultStopReason (get-state &bBoundary)) stopBudgetExhausted)
!(assertEqual (> (diagModelSize (resultDiagnostics (get-state &bBoundary))) 0) True)
!(assertEqual (bRun (mkOptimizerLimits 10 1000 20 -1) 1) (get-state &bBoundary))
!(assertEqual (resultStopReason (bRun (mkOptimizerLimits 100 10000 100 -1) 0)) stopTargetReached)
!(assertEqual (case (bRun (mkOptimizerLimits -2 1000 20 -1) 1)
  (((Error $v $reason) True) ($other False))) True)
!(set-param boaMaxTableCells 2)
!(assertEqual (case (bRun (mkOptimizerLimits 10 1000 20 -1) 1)
  (((Error $v $reason) True) ($other False))) True)
!(set-param boaMaxTableCells 256)
!(set-param edaPopulationSize 32)
!(set-param edaSelectionSize 16)
!(set-param edaOffspringSize 16)
