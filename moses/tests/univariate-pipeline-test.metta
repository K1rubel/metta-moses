(= (uvCSV $name)
   (parse (py-call (csv_helper.load_continuous_table_result (atom_concat "tests/fixtures/continuous/" $name) ""))))
(= (uvLearn $name $loss)
   (let $_random (py-call (random.seed 0))
     (runMoses 10 0.0 () 0 1 (mkContinCtx (uvCSV $name) $loss 0.0 linear 0.0) univariateOptimizer)))
(= (uvWinner $result)
   ((preOrder (getExemplarTree (bestRawExemplar $result)))
    (getScore (getExemplarCscore (bestRawExemplar $result)))))
(= (uvHeldout $result $name $loss)
   (getScore (continScoreTree (getExemplarTree (bestRawExemplar $result))
     (mkContinCtx (uvCSV $name) $loss 0.0 linear 0.0))))
!(set-param seed 0)
!(set-param continDepth 2)
!(set-param maxEvals 1000)
!(set-param maxGen 10)
!(set-param genCount 10)
!(set-param continTrace True)
!(bind! &uvLinear (new-state (uvLearn "linear-train.csv" squared_error)))
!(assertEqual (uvWinner (get-state &uvLinear)) ((c_add 1.0 (c_mul 2.0 "x")) 0.0))
!(assertEqual (uvHeldout (get-state &uvLinear) "linear-validation.csv" squared_error) 0.0)
!(assertEqual (uvHeldout (get-state &uvLinear) "linear-test.csv" squared_error) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 1000) True)
!(bind! &uvMulti (new-state (uvLearn "multivariate-train.csv" squared_error)))
!(assertEqual (uvWinner (get-state &uvMulti)) ((c_add 1.0 (c_mul 2.0 "x") (c_mul -1.0 "z")) 0.0))
!(assertEqual (uvHeldout (get-state &uvMulti) "multivariate-validation.csv" squared_error) 0.0)
!(assertEqual (uvHeldout (get-state &uvMulti) "multivariate-test.csv" squared_error) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 1000) True)
!(bind! &uvAbsolute (new-state (uvLearn "absolute-train.csv" abs_error)))
!(assertEqual (uvWinner (get-state &uvAbsolute)) ((c_add -1.0 (c_mul 0.5 "x")) 0.0))
!(assertEqual (uvHeldout (get-state &uvAbsolute) "absolute-validation.csv" abs_error) 0.0)
!(assertEqual (uvHeldout (get-state &uvAbsolute) "absolute-test.csv" abs_error) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 1000) True)
!(bind! &uvCorrelated (new-state (uvLearn "correlated-train.csv" squared_error)))
;; Pins seed-0 output; coefficient recovery is not unique when z=2*x.
!(assertEqual (uvWinner (get-state &uvCorrelated)) ((c_add 1.0 "x" "z") 0.0))
!(assertEqual (uvHeldout (get-state &uvCorrelated) "correlated-validation.csv" squared_error) 0.0)
!(assertEqual (uvHeldout (get-state &uvCorrelated) "correlated-test.csv" squared_error) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 1000) True)
!(set-param continTrace False)
!(assertEqual (uvWinner (uvLearn "linear-train.csv" squared_error)) ((c_add 1.0 (c_mul 2.0 "x")) 0.0))
!(set-param optAlgo univariate)
!(assertEqual (optimizer-for (param optAlgo)) univariateOptimizer)
!(set-param optAlgo hc)
;; Outer zero/tiny allowance still counts the continuous seed, with no fabricated result.
!(set-param maxEvals 0)
!(assertEqual (uvLearn "linear-train.csv" squared_error) ())
!(set-param maxEvals 1)
!(assertEqual (uvWinner (uvLearn "linear-train.csv" squared_error)) (0.0 -45.0))
!(set-param maxEvals 1000)

;; Real Boolean representation and scorer through the same optimizer boundary.
(= (uvBooleanKnob) (mkLSK (mkDiscKnob (mkMultip 3) (mkDiscSpec 0) (mkDiscSpec 0) ())))
(= (uvBooleanRep)
   (mkRep (mkKbMap (mkDscMp (((mkDiscSpec 3) (uvBooleanKnob)) ((mkDiscSpec 3) (uvBooleanKnob)))))
     (mkTree (mkNode AND)
       ((mkKnob (mkNullVex ((mkTree (mkNode A) ()))) (uvBooleanKnob) 0)
        (mkKnob (mkNullVex ((mkTree (mkNode B) ()))) (uvBooleanKnob) 1)))))
;; Legacy Boolean tables are row-major (unlike continuous column-major tables).
(= (uvBooleanTable) (mkITable ((False False False) (True False False) (False True False) (True True True)) (A B O)))
!(bind! &uvBoolean (new-state
   (let $_cache (resetCandidateScoreCache)
     (optimizeDeme (mkDeme (uvBooleanRep) (mkSInstSet ()) (mkDemeId "uvBoolean"))
       (mkOptimizerContext (mkTruthTableBScore 0.0 4 (uvBooleanTable)) 0)
       (mkInst (0 0)) (mkOptimizerLimits 20 200 20 -1) 1 (mkOptimizerConfig univariate)))))
!(assertEqual (resultStopReason (get-state &uvBoolean)) stopTargetReached)
!(assertEqual (let (mkDeme $r (mkSInstSet $rows) $id) (resultDeme (get-state &uvBoolean))
                  (bestRawScore $rows)) 0)
!(assertEqual (let (mkDeme $r $rows $id) (resultDeme (get-state &uvBoolean))
                  (preOrder (getCandidate $r $id (resultBestInstance (get-state &uvBoolean)))))
              (quote (AND A B)))
!(assertEqual (<= (resultActualEvaluations (get-state &uvBoolean)) 9) True)

;; Action merge must materialize exactly as the scorer does, including tied
;; candidate scores. A failed duplicate filter must not restart the outer run.
!(set-param fitness antFitness)
!(set-param actions (quote (antMoveForward antTurnLeft antTurnRight)))
!(set-param perceptions (quote (antFoodAhead)))
!(set-param nTrials 4)
!(set-param maxEvals 10)
!(set-param genCount 1)
(= (uvAntSeed)
   (mkExemplar (ant-exemplar) (mkDemeId "1")
     (mkCscore -4.0 0 3.5 0 -4.0) (mkBScore (-1.0 -1.0 -1.0 -1.0))))
!(bind! &uvAntResults (new-state
   (let* (($_rng (py-call (random.seed 0))) ($_cache (clearSpace &actionScoreCache)))
     (collapse (runMoses 1 20.0 ((uvAntSeed)) 0 1 (mkActionCtx 4 3.5 20.0) univariateOptimizer)))))
!(assertEqual (List.length (get-state &uvAntResults)) 1)
!(assertEqual (getScore (getExemplarCscore (bestRawExemplar (car-atom (get-state &uvAntResults))))) 20)
!(assertEqual (preOrder (getExemplarTree (bestRawExemplar (car-atom (get-state &uvAntResults)))))
              (quote (and_seq (action_bool_if antFoodAhead antMoveForward antTurnRight) and_seq)))
