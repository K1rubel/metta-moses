;; Step 7 integration: execute the real shared HC/merge/outer loop.
(= (ctCtx) (mkContinCtx (linearDemoTable) squared_error 0.0 linear 0.0))
(= (ctLeaf $x) (mkTree (mkNode $x) ()))
(= (ctReset)
   (let* (($_a (resetCandidateScoreCache)) ($_b (resetContinBehaviorCache))
          ($_c (clearSpace &treeSpace))) True))
(= (ctCacheSize) (List.length (collapse (match &candidateScoreCache (candidateEvaluation $ctx $tree $score $status) $tree))))
(= (ctRep) (configuredAffineRepresentation (ctLeaf 0.0) (ctCtx)))
(= (ctDeme) (mkDeme (ctRep) (mkSInstSet ()) (mkDemeId "test")))
(= (ctDefault) (schemaDefaultInstance (continFieldSchema (ctRep))))
(= (ctRows (mkDeme $rep (mkSInstSet $rows) $id)) $rows)
(= (ctResultRows $result) (ctRows (resultDeme $result)))
(= (ctOptimize $limits $rng)
   (let $_ (ctReset)
     (optimizeDeme (ctDeme) (optimizerContextFor (ctCtx) 0.0) (ctDefault) $limits $rng (mkOptimizerConfig hc))))
(= (ctCanonicalRows $rep $rows)
   (case $rows
     ((() True)
      ((cons $row $rest)
       (and (== (getInst $row) (canonicalizeInstance (continFieldSchema $rep) (getInst $row)))
            (ctCanonicalRows $rep $rest))))))
(= (ctBestRaw $population) (getScore (getExemplarCscore (bestRawExemplar $population))))
(= (ctRun $context $generations)
   (let $_rng (py-call (random.seed 0))
     (runMoses $generations (continCtxTargetScore $context) () 0 (param nDeme) $context hillClimbingOptimizer)))

!(assertEqual (validateContinRun (ctCtx)) True)
!(assertEqual (optimizerContextFor (ctCtx) -0.01) (mkOptimizerContext (ctCtx) -0.01))
!(assertEqual (mergeContextFor (ctCtx)) (ctCtx))
!(assertEqual (hcContextParts (ctCtx)) ((ctCtx) 0.0))
!(assertEqual (hcContextParts (mkOptimizerContext (ctCtx) -0.01)) ((ctCtx) -0.01))
!(assertEqual (scoreImproved (ctCtx) -0.9 -1.0) True)
!(assertEqual (scoreImproved (mkActionCtx 1 0 0) -0.9 -1.0) False)
!(set-param continImprovementThreshold -0.2)
!(assertEqual (scoreImproved (ctCtx) -0.9 -1.0) False)
!(set-param continImprovementThreshold -0.0001)
!(assertEqual (validateContinRun (mkContinCtx (linearDemoTable) squared_error 0 nonlinear 0))
              True)
!(assertEqual (validateContinRun (mkContinCtx (mkITable ((True) (1)) (x y)) squared_error 0 linear 0))
              (mkCEvalError "InvalidTable"))
!(set-param continDepth 0)
!(assertEqual (validateContinRun (ctCtx)) (mkCEvalError "InvalidContinSpec"))
!(set-param continDepth 2)
!(set-param maxEvals 100)
!(set-param maxGen 2)
!(set-param genCount 2)
!(assertEqual (List.length (schemaFields (continFieldSchema (ctRep)))) 4)
!(assertEqual (ctDefault) (mkInst (0 0 0 0)))
!(assertEqual (createContinDemes () (ctLeaf 0.0) (ctCtx)) ())
!(bind! &ctSeeds (new-state (let $_ (ctReset) (initializeContinRun (ctCtx) ()))))
!(assertEqual (second (get-state &ctSeeds)) 1)
!(assertEqual (ctBestRaw (first (get-state &ctSeeds))) -45.0)
!(assertEqual (ctCacheSize) 1)
!(assertEqual (cachedContinBehavior (ctCtx) (ctLeaf 0.0)) (mkBScore (-9.0 -1.0 -1.0 -9.0 -25.0)))
!(bind! &ctDemes (new-state (createSelectedDemes (List.head (first (get-state &ctSeeds))) 0 2 (ctCtx))))
!(assertEqual (List.length (get-state &ctDemes)) 2)
!(assertEqual (createSelectedDemes (List.head (first (get-state &ctSeeds))) 0 0 (ctCtx)) ())
!(assertEqual (let ((mkDeme $rep1 $rows1 $id1) (mkDeme $rep2 $rows2 $id2)) (get-state &ctDemes)
                (and (not (== $id1 $id2)) (and (== $rows1 (mkSInstSet ())) (== $rows2 (mkSInstSet ()))))) True)
!(assertEqual (let $demes (createSelectedDemes (List.head (first (get-state &ctSeeds))) 1 1 (ctCtx))
                (let (mkDeme $rep $rows $id) (List.head $demes) $id)) (mkDemeId (numStr 2)))
;; Recenter around 1 + 3*x: all STOP reconstructs it and a left coefficient
;; step now means 2*x, unlike that same vector in the original zero scaffold.
(= (ctRecenterTree) (mkTree (mkNode c_add) ((ctLeaf 1.0) (mkTree (mkNode c_mul) ((ctLeaf 3.0) (ctLeaf x))))))
!(bind! &ctRecenter (new-state (configuredAffineRepresentation (ctRecenterTree) (ctCtx))))
!(assertEqual (finalizeContinCandidate (get-state &ctRecenter) (ctDefault)) (ctRecenterTree))
!(assertEqual (continSpecMean (fieldSpec (List.getByIdx (schemaFields (continFieldSchema (get-state &ctRecenter))) 2))) 3.0)
!(assertEqual (continEval (finalizeContinCandidate (get-state &ctRecenter) (mkInst (0 0 1 0))) ((mkContinBinding x 2))) (mkCEvalOk 5.0))
!(assertEqual (continEval (finalizeContinCandidate (ctRep) (mkInst (0 0 1 0))) ((mkContinBinding x 2))) (mkCEvalOk -2.0))

;; Local limits and explicit state/status, including cache reuse after STOP.
!(bind! &ctZero (new-state (ctOptimize (mkOptimizerLimits 0 20 10 -1) 1)))
!(assertEqual (resultActualEvaluations (get-state &ctZero)) 0)
!(assertEqual (ctResultRows (get-state &ctZero)) ())
!(assertEqual (resultStopReason (get-state &ctZero)) stopBudgetExhausted)
!(bind! &ctOne (new-state (ctOptimize (mkOptimizerLimits 1 20 10 -1) 1)))
!(assertEqual (resultActualEvaluations (get-state &ctOne)) 1)
!(assertEqual (List.length (ctResultRows (get-state &ctOne))) 1)
!(assertEqual (resultStopReason (get-state &ctOne)) stopBudgetExhausted)
!(assertEqual (resultStopReason (ctOptimize (mkOptimizerLimits 20 0 10 -1) 1)) stopProposalsExhausted)
!(assertEqual (resultStopReason (ctOptimize (mkOptimizerLimits 20 20 0 -1) 1)) stopGenerationsExhausted)
!(assertEqual (resultStopReason (ctOptimize (mkOptimizerLimits 20 20 10 0) 1)) stopTimeExhausted)
!(bind! &ctSeven (new-state (ctOptimize (mkOptimizerLimits 7 100 10 -1) 123)))
!(assertEqual (and (> (resultActualEvaluations (get-state &ctSeven)) 1)
                  (<= (resultActualEvaluations (get-state &ctSeven)) 7)) True)
!(assertEqual (ctCacheSize) (resultActualEvaluations (get-state &ctSeven)))
!(assertEqual (ctCanonicalRows (ctRep) (ctResultRows (get-state &ctSeven))) True)
!(assertEqual (ctOptimize (mkOptimizerLimits 7 100 10 -1) 123) (get-state &ctSeven))
!(assertEqual (get-state &hcActive) False)
!(assertEqual (let* (($_ (ctReset))
                     ($rows ((mkEvaluatedCandidate (mkInst (0 1 0 2)) () () candidatePending)
                             (mkEvaluatedCandidate (mkInst (0 2 0 1)) () () candidatePending)))
                     ($result (optimizeDeme (mkDeme (ctRep) (mkSInstSet $rows) (mkDemeId "tails"))
                                (ctCtx) (ctDefault) (mkOptimizerLimits 10 20 1 -1) 1 (mkOptimizerConfig hc))))
                ((resultActualEvaluations $result) (List.length (ctResultRows $result))
                 (ctCanonicalRows (ctRep) (ctResultRows $result)))) (1 1 True))

;; Continuous merge needs no scorer calls: behavior is retained by evaluation.
!(bind! &ctMergeInput (new-state (ctOptimize (mkOptimizerLimits 7 100 10 -1) 123)))
!(bind! &ctBeforeMerge (new-state (ctCacheSize)))
!(bind! &ctMerged (new-state (mergeDemes ((resultDeme (get-state &ctMergeInput))) (ctCtx) ())))
!(assertEqual (ctCacheSize) (get-state &ctBeforeMerge))
!(assertEqual (> (List.length (get-state &ctMerged)) 0) True)
!(assertEqual (foldl-atom (get-state &ctMerged) True $ok $exemplar
                (and $ok (== (getExemplarBScore $exemplar)
                             (cachedContinBehavior (ctCtx) (getExemplarTree $exemplar))))) True)
!(assertEqual (diagnosticDemeTrees ((resultDeme (get-state &ctMergeInput))) (ctCtx))
              (map-atom (ctResultRows (get-state &ctMergeInput)) $row (finalizeContinCandidate (ctRep) (getInst $row))))
!(assertEqual (collapse (match &treeSpace $entry $entry)) ())

;; A high penalty ranks the zero program ahead of a perfect affine candidate;
;; target stopping and final output still preserve the separate raw champion.
!(set-param continDepth 1)
(= (ctPenaltyCtx) (mkContinCtx (mkITable ((0.0 1.0) (1.0 2.0)) (x y)) squared_error 100.0 linear 0.0))
(= (ctPenaltyRep) (configuredAffineRepresentation (ctLeaf 0.0) (ctPenaltyCtx)))
!(bind! &ctPenaltyResult (new-state
   (let* (($_ (ctReset))
          ($rows ((mkEvaluatedCandidate (mkInst (0 0)) () () candidatePending)
                  (mkEvaluatedCandidate (mkInst (2 2)) () () candidatePending))))
     (optimizeDeme (mkDeme (ctPenaltyRep) (mkSInstSet $rows) (mkDemeId "penalty"))
       (ctPenaltyCtx) (mkInst (0 0)) (mkOptimizerLimits 10 10 1 -1) 1 (mkOptimizerConfig hc)))))
!(assertEqual (resultStopReason (get-state &ctPenaltyResult)) stopTargetReached)
!(assertEqual (resultActualEvaluations (get-state &ctPenaltyResult)) 2)
!(assertEqual (resultBestInstance (get-state &ctPenaltyResult)) (mkInst (0 0)))
!(assertEqual (bestRawDeme (resultDeme (get-state &ctPenaltyResult))) 0.0)
!(bind! &ctRaw (new-state (bestRawExemplarFromDemes ((resultDeme (get-state &ctPenaltyResult))) (ctPenaltyCtx))))
!(assertEqual (rawTargetReached (get-state &ctRaw) 0.0) True)
!(assertEqual (< (getExemplarPenScore (get-state &ctRaw)) 0.0) True)
!(set-param maxCandOutput 1)
!(assertEqual (finishMetapop (mergeDemes ((resultDeme (get-state &ctPenaltyResult))) (ctPenaltyCtx) ()) (get-state &ctRaw)) ((get-state &ctRaw)))
!(set-param maxCandOutput 10)

;; Full loop and run-wide initialization/budget/cache isolation.
!(set-param continDepth 2)
!(set-param maxEvals 0)
!(assertEqual (ctRun (ctCtx) 2) ())
!(assertEqual (ctCacheSize) 0)
!(set-param maxEvals 1)
!(assertEqual (ctBestRaw (ctRun (ctCtx) 2)) -45.0)
!(assertEqual (ctCacheSize) 1)
!(set-param maxEvals 2)
!(assertEqual (> (List.length (ctRun (ctCtx) 2)) 0) True)
!(assertEqual (ctCacheSize) 2)
!(set-param maxEvals 100)
!(set-param nDeme 0)
!(assertEqual (ctBestRaw (ctRun (ctCtx) 2)) -45.0)
!(assertEqual (ctCacheSize) 1)
!(set-param nDeme 1)
!(assertEqual (ctBestRaw (ctRun (ctCtx) 0)) -45.0)
!(assertEqual (ctCacheSize) 1)
!(assertEqual (ctBestRaw (ctRun (ctCtx) 2)) 0.0)
!(assertEqual (ctCacheSize) 29)
!(assertEqual (collapse (match &subtreeCache $entry $entry)) ())
!(assertEqual (collapse (match &treeSpace $entry $entry)) ())
!(assertEqual (ctBestRaw (ctRun (mkContinCtx (mkITable ((0.0 1.0) (0.0 0.0)) (x y)) abs_error 3.0 linear 0.0) 2)) 0.0)
!(assertEqual (ctCacheSize) 1)
!(assertEqual (cachedContinBehavior (ctCtx) (ctLeaf 0.0)) (mkCEvalError "MissingContinuousBehavior"))
;; Finite raw scores below worstCscore are valid; overflowing seeds are not.
!(assertEqual (< (ctBestRaw (ctRun (mkContinCtx (mkITable ((0.0) (1e60)) (x y)) squared_error 0.0 linear 0.0) 0)) -1e100) True)
!(assertEqual (ctRun (mkContinCtx (mkITable ((0.0) (1e308)) (x y)) squared_error 0.0 linear 0.0) 2) ())
!(assertEqual (ctCacheSize) 1)
!(set-param problem linear)
!(assertEqual (problem-context) ((ctCtx) () 0.0))
!(set-param bestScore -0.1)
!(assertEqual (List.getByIdx (problem-context) 2) -0.1)
!(set-param bestScore ())

;; Multiple local demes share the remaining global allowance, not one full
;; allowance each. Seed consumes one call before these shares are assigned.
!(set-param maxEvals 4)
!(set-param nDeme 3)
!(assertEqual (> (List.length (ctRun (ctCtx) 1)) 0) True)
!(assertEqual (<= (ctCacheSize) 4) True)
!(assertEqual (>= (ctCacheSize) 2) True)
!(set-param maxEvals 100)
!(set-param nDeme 1)
;; Seeds are rescored in this context, including duplicated supplied trees.
(= (ctFakeSeeds)
   ((mkExemplar (ctLeaf 0.0) (mkDemeId "a") (worstCscore) (mkBScore (999)))
    (mkExemplar (ctLeaf 0.0) (mkDemeId "b") (worstCscore) (mkBScore (999)))))
!(assertEqual (let* (($_ (ctReset)) (($pop $used) (initializeContinRun (ctCtx) (ctFakeSeeds))))
                ($used (ctBestRaw $pop))) (1 -45.0))
!(assertEqual (let* (($_ (ctReset))
                     (($pop $used) (initializeContinRun
                       (mkContinCtx (mkITable ((0.0) (2.0)) (x y)) abs_error 0.0 linear 0.0) (ctFakeSeeds))))
                ($used (ctBestRaw $pop))) (1 -2.0))
!(set-param continDepth 1)
!(set-param maxCandOutput 1)
!(assertEqual (let* (($perfect (mkTree (mkNode c_add) ((ctLeaf 1.0) (ctLeaf x))))
                     ($seeds ((mkExemplar (ctLeaf 0.0) (mkDemeId "a") () ())
                              (mkExemplar $perfect (mkDemeId "b") () ())))
                     ($pop (runMoses 2 0.0 $seeds 0 1 (ctPenaltyCtx) hillClimbingOptimizer)))
                ((List.length $pop) (ctBestRaw $pop))) (1 0.0))
!(assertEqual (ctCacheSize) 2)
!(set-param maxCandOutput 10)
!(set-param continDepth 2)
!(set-param continTable (mkITable ((0.0 1.0) (0.0 0.0)) (a out)))
!(assertEqual (let ($ctx $pop $target) (problem-context) (continCtxTable $ctx))
              (mkITable ((0.0 1.0) (0.0 0.0)) (a out)))
!(assertEqual (let (FinalResult $pairs) (moses) (second (List.head $pairs))) 0.0)
!(set-param continTable ())
!(set-param maxEvals 0.5)
!(assertEqual (validateContinRun (ctCtx)) (mkCEvalError "InvalidContinuousRunLimits"))
!(set-param maxEvals 100)
