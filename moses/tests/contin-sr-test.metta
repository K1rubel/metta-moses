;; Same nonlinear settings and zero seed for every optimizer. This is a
;; deterministic correctness/integration gate, NOT a performance study.
(= (srLearn $optimizer)
 (let $_rng (py-call (random.seed 0))
  (runMoses 10 0.0 () 0 1 (mkContinCtx (srDemoTable) squared_error 0.0 nonlinear 0.0) $optimizer)))
(= (srWinner $result)
 ((preOrder (getExemplarTree (bestRawExemplar $result))) (getScore (getExemplarCscore (bestRawExemplar $result)))))
(= (srHeldout $result)
 (getScore (continScoreTree (getExemplarTree (bestRawExemplar $result))
  (mkContinCtx (mkITable ((-3 -0.5 0.5 3) (6 -0.25 0.75 12)) (x y)) squared_error 0.0 nonlinear 0))))
!(set-param seed 0)
!(set-param continDepth 1)
!(set-param continPolyDegree 2)
!(set-param continScaffoldDepth 1)
!(set-param continOperators (c_add c_mul))
!(set-param maxEvals 300)
!(set-param maxGen 10)
!(set-param genCount 10)
!(set-param continTrace True)
!(assertEqual (srProblemContext) ((mkContinCtx (srDemoTable) squared_error 0.0 nonlinear 0.0) () 0.0))
!(assertEqual (linearProblemContext) ((mkContinCtx (linearDemoTable) squared_error 0.0 linear 0.0) () 0.0))

!(bind! &srhc (new-state (srLearn hillClimbingOptimizer)))
!(assertEqual (srWinner (get-state &srhc)) ((c_add x (c_mul x x)) 0.0))
!(assertEqual (srHeldout (get-state &srhc)) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 300) True)

!(bind! &srunivariate (new-state (srLearn univariateOptimizer)))
!(assertEqual (srWinner (get-state &srunivariate)) ((c_add x (c_mul x x)) 0.0))
!(assertEqual (srHeldout (get-state &srunivariate)) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 300) True)

!(bind! &srboa (new-state (srLearn boaOptimizer)))
!(assertEqual (srWinner (get-state &srboa)) ((c_add x (c_mul x x)) 0.0))
!(assertEqual (srHeldout (get-state &srboa)) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 300) True)

!(bind! &srhboa (new-state (srLearn hboaOptimizer)))
!(assertEqual (srWinner (get-state &srhboa)) ((c_add x (c_mul x x)) 0.0))
!(assertEqual (srHeldout (get-state &srhboa)) 0.0)
!(assertEqual (<= (get-state &continTraceCalls) 300) True)

!(set-param maxEvals 0)
!(assertEqual (srLearn hillClimbingOptimizer) ())
!(set-param maxEvals 1)
!(assertEqual (srWinner (srLearn hboaOptimizer)) (0.0 -44.0))
!(set-param maxEvals 300)
!(set-param continPolyDegree 5)
!(assertEqual (validateContinRun (mkContinCtx (srDemoTable) squared_error 0 nonlinear 0)) (mkCEvalError "InvalidNonlinearConfig"))
!(assertEqual (validateContinRun (mkContinCtx (linearDemoTable) squared_error 0 linear 0)) True)
!(set-param continPolyDegree 2)
