!(import! &self ../../utilities/general-helpers)
!(import! &self ../../utilities/list-methods)
!(import! &self ../../parameters/registry)
!(import! &self ../../parameters/defaults)
!(import! &self ../cacheSpace)
!(import! &self ../cscore)
!(import! &self ../contin-eval)
!(import! &self ../contin-score)
!(import! &self ../../representation/knob-representation)
!(import! &self ../../representation/contin-spec)
!(import! &self ../../representation/contin-stepper)
!(import! &self ../../representation/contin-representation)
!(import! &self ../../representation/field-schema)
!(import! &self ../../reduct/contin-reduct/contin-helpers)
!(import! &self ../../reduct/contin-reduct/reduce-identities)
!(import! &self ../../reduct/contin-reduct/reorder-commutative)
!(import! &self ../../reduct/contin-reduct/reduce-nary)
!(import! &self ../../reduct/contin-reduct/reduce-division)
!(import! &self ../../reduct/contin-reduct/fold-constants)
!(import! &self ../../reduct/contin-reduct/reduce-nonlinear)
!(import! &self ../../reduct/contin-reduct/contin-reduction)
!(import! &self ../../optimization/optimizer-contract)
!(import! &self ../candidate-evaluation)

(= (leaf $x) (mkTree (mkNode $x) ()))
(= (node $op $children) (mkTree (mkNode $op) $children))
(= (affine) (node c_add ((node c_mul ((leaf 2) (leaf x))) (leaf 1))))
(= (data) (mkITable ((0 1 2) (1.5 2 6)) (x y)))
(= (context $error $ratio) (mkContinCtx (data) $error $ratio linear 0))

!(assertEqual (continEval (leaf 3) ()) (mkCEvalOk 3.0))
!(assertEqual (continEval (leaf x) ((mkContinBinding x 4))) (mkCEvalOk 4.0))
!(assertEqual (continEval (affine) ((mkContinBinding x 2))) (mkCEvalOk 5.0))
!(assertEqual (continEval (node c_exp ((leaf 0))) ()) (mkCEvalOk 1.0))
!(assertEqual (continEval (node c_log ((leaf 1))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_sin ((leaf 0))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_div ((leaf 3) (leaf 2))) ()) (mkCEvalOk 1.5))
!(assertEqual (continEval (node c_div ((leaf 0) (leaf 0))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_div ((leaf 0) (leaf unknown))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_mul ((leaf 0) (leaf unknown))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_mul ((leaf unknown) (leaf 0))) ()) (mkCEvalError "UnknownLabel"))
!(assertEqual (continEval (node c_div ((leaf 1) (leaf 0))) ()) (mkCEvalError "DivisionByZero"))
!(assertEqual (continEval (node c_div ((leaf 1e-300) (leaf 1e-300))) ()) (mkCEvalOk 1.0))
!(assertEqual (continEval (node c_log ((leaf 0))) ()) (mkCEvalError "LogNonPositive"))
!(assertEqual (continEval (node c_log ((leaf -1))) ()) (mkCEvalError "LogNonPositive"))
!(assertEqual (continEval (node c_exp ((leaf 1000))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (node c_mul ((leaf 1e308) (leaf 1e308) (leaf 0))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (node c_add ((leaf 1e308) (leaf 1e308))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (node c_div ((leaf 1e308) (leaf 1e-300))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (node c_add ()) ()) (mkCEvalError "ArityMismatch"))
!(assertEqual (continEval (node c_mul ()) ()) (mkCEvalError "ArityMismatch"))
!(assertEqual (continEval (node c_div ((leaf 0))) ()) (mkCEvalError "ArityMismatch"))
!(assertEqual (continEval (node c_sin ((leaf 0) (leaf 1))) ()) (mkCEvalError "ArityMismatch"))
!(assertEqual (continEval (node AND ((leaf 1))) ()) (mkCEvalError "UnknownOperator"))
!(assertEqual (continEval malformed ()) (mkCEvalError "InvalidTree"))
!(assertEqual (continPrepareContext (context squared_error 0.1)) (mkContinData (x) ((0 1 2)) (1.5 2 6)))
!(assertEqual (continScoreTree (affine) (context squared_error 0)) (mkCscore -2.25 3 0 0.0 -2.25))
!(assertEqual (continScoreTree (affine) (context abs_error 0)) (mkCscore -2.5 3 0 0.0 -2.5))
!(assertEqual (getPenScore (continScoreTree (affine) (context squared_error 0.1))) -2.55)
!(assertEqual (continScoreTree (leaf y) (context squared_error 0)) (mkCEvalError "UnknownLabel"))
!(assertEqual (scoreMaterializedCandidate (leaf y) (context squared_error 0))
              (mkCandidateScore (worstCscore) (candidateInvalid "UnknownLabel")))
!(assertEqual (collapse (scoreMaterializedCandidate (affine) (context squared_error 0)))
              ((mkCandidateScore (mkCscore -2.25 3 0 0.0 -2.25) candidateValid)))

;; Short-circuit order, non-finite constants/inputs, and nontrivial unary ops.
!(assertEqual (continEval (node c_mul ((leaf 1e-300) (leaf 1e-300) (leaf missing))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_mul ((leaf 2) (leaf 0) (node c_log ((leaf -1))))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_add ((leaf 0) (leaf missing))) ()) (mkCEvalError "UnknownLabel"))
!(assertEqual (continEval (node c_div ((leaf missing) (leaf 0))) ()) (mkCEvalError "UnknownLabel"))
!(assertEqual (continEval (node c_div ((leaf 1) (leaf missing))) ()) (mkCEvalError "UnknownLabel"))
!(assertEqual (continEval (node c_div ((leaf 0) (node c_exp ((leaf 1000))))) ()) (mkCEvalOk 0.0))
!(assertEqual (continEval (node c_add ((leaf 2))) ()) (mkCEvalOk 2.0))
!(assertEqual (continEval (node c_mul ((leaf 2))) ()) (mkCEvalOk 2.0))
!(assertEqual (continEval (node c_log ()) ()) (mkCEvalError "ArityMismatch"))
!(assertEqual (continEval (node c_exp ((leaf 1) (leaf 2))) ()) (mkCEvalError "ArityMismatch"))
!(assertEqual (continEval (node c_div ((leaf 0) (leaf 1) (leaf 2))) ()) (mkCEvalError "ArityMismatch"))
!(assertEqual (continEval (node c_add notAList) ()) (mkCEvalError "InvalidTree"))
!(assertEqual (continEval (leaf x) notAnEnvironment) (mkCEvalError "InvalidEnvironment"))
!(assertEqual (continEval (leaf x) ((mkContinBinding x "bad"))) (mkCEvalError "NonNumeric"))
!(assertEqual (continEval (leaf (py-call (builtins.float "inf"))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (leaf (py-call (builtins.float "nan"))) ()) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (leaf x) ((mkContinBinding x (py-call (builtins.float "inf"))))) (mkCEvalError "NonFinite"))
!(assertEqual (continEval (leaf (pow-math 10 400)) ()) (mkCEvalError "NonFinite"))
(= (closeTo $x $y) (< (py-call (math.fabs (- $x $y))) 1e-12))
!(assertEqual (closeTo (getCEvalValue (continEval (node c_sin ((leaf 1))) ())) 0.8414709848078965) True)
!(assertEqual (closeTo (getCEvalValue (continEval (node c_log ((node c_exp ((leaf 2))))) ())) 2.0) True)

;; Exact labels and column order, including an intercept-only dataset.
!(assertEqual (continRowEnvironment (z x) ((5 6) (1 2))) ((mkContinBinding z 5) (mkContinBinding x 1)))
!(assertEqual (continNextColumns ((5 6) (1 2))) ((6) (2)))
!(assertEqual (continScoreTree (leaf "feature name")
                (mkContinCtx (mkITable ((2 3) (2 3)) ("feature name" "target")) squared_error 0 linear 0))
              (mkCscore 0.0 1 0 0.0 0.0))
!(assertEqual (continScoreTree (node c_add ((leaf x) (node c_mul ((leaf 2) (leaf z)))))
                (mkContinCtx (mkITable ((5 6) (1 2) (11 14)) (z x y)) squared_error 0 nonlinear 0))
              (mkCscore 0.0 3 0 0.0 0.0))
!(assertEqual (continScoreTree (leaf 2) (mkContinCtx (mkITable ((2 2)) (y)) squared_error 0 linear 0))
              (mkCscore 0.0 1 0 0.0 0.0))
!(assertEqual (continScoreTree (affine) (mkContinCtx (data) squared_error 0 nonlinear -10))
              (continScoreTree (affine) (context squared_error 0)))

;; Malformed/empty/ragged/non-finite tables fail even for constant candidates.
!(assertEqual (continPrepareTable badTable) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable () ())) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable (() ()) (x y))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((1 2) (3)) (x y))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((1) (2)) (x))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((1) (2)) (x y z))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((1) (2)) (x x))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((1) (2)) (1 y))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((1) (2)) (c_add y))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((1) badColumn) (x y))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable ((True) (2)) (x y))) (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareTable (mkITable (("1") (2)) (x y))) (mkCEvalError "InvalidTable"))
!(assertEqual (continScoreTree (leaf 0)
                (mkContinCtx (mkITable (((py-call (builtins.float "nan"))) (2)) (x y)) squared_error 0 linear 0))
              (mkCEvalError "InvalidTable"))
!(assertEqual (continPrepareContext (context squared_error -0.1)) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareContext (context unknown_error 0)) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareContext (context squared_error (py-call (builtins.float "inf")))) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareContext (mkContinCtx (data) squared_error 0 unsupported 0)) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareContext (mkContinCtx (data) squared_error 0 linear (py-call (builtins.float "nan")))) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareContext badContext) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareContext (context squared_error "bad")) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareContext (mkContinCtx (data) squared_error 0 linear "bad")) (mkCEvalError "InvalidContext"))
!(assertEqual (continPrepareTable (mkITable ((1) (2)) badLabels)) (mkCEvalError "InvalidTable"))
!(assertEqual (continScoreTree (node c_mul ((leaf 0) malformed)) (context squared_error 0)) (mkCEvalError "InvalidTree"))

;; Overflow of residual, square, aggregate, complexity penalty, final score.
(= (zeroTarget $error $ratio) (mkContinCtx (mkITable ((0)) (y)) $error $ratio linear 0))
!(assertEqual (continScoreTree (leaf 1e200) (zeroTarget squared_error 0)) (mkCEvalError "NonFinite"))
!(assertEqual (continScoreTree (leaf 1e308)
                (mkContinCtx (mkITable ((-1e308)) (y)) abs_error 0 linear 0)) (mkCEvalError "NonFinite"))
!(assertEqual (continScoreTree (leaf 1e154)
                (mkContinCtx (mkITable ((0 0)) (y)) squared_error 0 linear 0)) (mkCEvalError "NonFinite"))
!(assertEqual (continScoreTree (node c_add ((leaf 0) (leaf 0))) (zeroTarget squared_error 1e308)) (mkCEvalError "NonFinite"))
!(assertEqual (continScoreTree (leaf 1e308) (zeroTarget abs_error 1e308)) (mkCEvalError "NonFinite"))
!(assertEqual (continScoreTree (node c_mul ((leaf 0) (leaf unknown))) (zeroTarget squared_error 1))
              (mkCscore 0.0 0 0 0.0 0.0))
!(assertEqual (continScoreTree (leaf 0) (zeroTarget squared_error 1)) (mkCscore 0.0 1 1 0.0 -1.0))
!(assertEqual (continScoreTree (node c_sin ((leaf 0))) (zeroTarget squared_error 1)) (mkCscore 0.0 2 2 0.0 -2.0))
!(assertEqual (continScoreTree (node c_div ((leaf 1) (leaf x)))
                (mkContinCtx (mkITable ((1 0 2) (1 0 0.5)) (x y)) squared_error 0 linear 0))
              (mkCEvalError "DivisionByZero"))
!(assertEqual (let (mkCandidateScore $score $status) (scoreContinCandidate (leaf 1e60) (zeroTarget squared_error 0))
                (and (== $status candidateValid) (< (getScore $score) -1e100))) True)
!(assertEqual (scoreImproved (context squared_error 0) -99.98 -100) True)
!(assertEqual (scoreImproved (context squared_error 0) -99.99 -100) False)
!(assertEqual (scoreImproved (context squared_error 0) -99.995 -100) False)
!(assertEqual (scoreImproved booleanContext -9.6 -10) False)
!(assertEqual (scoreImprovedWithThreshold 1e308 1e308 1e308) False)
!(assertEqual (scoreImprovedWithThreshold 0 (- 0 (pow-math 10 400)) -0.0001) False)

;; Shared counted/cache service with an explicit materializer for already-built
;; trees. Production decoding is covered by representation/tests/contin-fields-test.
!(bind! &continCalls (new-state 0))
(= (continTestMaterialize $rep $id (mkInst ($n)) $ctx)
   (case $n ((0 (affine)) (1 (affine)) (2 (leaf 0)) (3 (leaf y))
             (4 (node c_exp ((leaf 1000)))))))
(= (continTestScore $tree $ctx)
   (let $_count (change-state! &continCalls (+ 1 (get-state &continCalls)))
     (scoreMaterializedCandidate $tree $ctx)))
(= (cpending $n) (mkEvaluatedCandidate (mkInst ($n)) () () candidatePending))
(= (cbatch $rows $ctx $budget)
   (evaluateCandidateBatchWith $rows rep id $ctx $budget continTestMaterialize continTestScore))
(= (csummary $batch)
   ((continListLength (batchEvaluated $batch)) (continListLength (batchPending $batch))
    (batchActualEvaluations $batch) (batchCacheHits $batch) (batchDecodeFailures $batch)))
!(resetCandidateScoreCache)
!(assertEqual (csummary (cbatch ((cpending 0)) (context squared_error 0) 0)) (0 1 0 0 0))
!(assertEqual (get-state &continCalls) 0)
!(bind! &continBatch (new-state ()))
!(change-state! &continBatch (cbatch ((cpending 0) (cpending 1) (cpending 2)) (context squared_error 0) 1))
!(assertEqual (csummary (get-state &continBatch)) (2 1 1 1 0))
!(assertEqual (get-state &continCalls) 1)
!(assertEqual (csummary (cbatch (batchPending (get-state &continBatch)) (context squared_error 0) 1)) (1 0 1 0 0))
!(assertEqual (get-state &continCalls) 2)
!(assertEqual (csummary (cbatch ((cpending 3) (cpending 3)) (context squared_error 0) 1)) (2 0 1 1 0))
!(assertEqual (get-state &continCalls) 3)
!(assertEqual (candidateStatus (car-atom (batchEvaluated (cbatch ((cpending 3)) (context squared_error 0) 0))))
              (candidateInvalid "UnknownLabel"))
!(assertEqual (get-state &continCalls) 3)
!(assertEqual (csummary (cbatch ((cpending 0)) (context abs_error 0) 1)) (1 0 1 0 0))
!(assertEqual (csummary (cbatch ((cpending 0)) (context squared_error 0.1) 1)) (1 0 1 0 0))
!(assertEqual (csummary (cbatch ((cpending 0))
                (mkContinCtx (mkITable ((0 1 2) (1 3 5)) (x y)) squared_error 0 linear 0) 1)) (1 0 1 0 0))
!(assertEqual (get-state &continCalls) 6)
!(assertEqual (csummary (cbatch ((cpending 4) (cpending 4)) (context squared_error 0) 1)) (2 0 1 1 0))
!(assertEqual (get-state &continCalls) 7)
!(assertEqual (candidateStatus (car-atom (batchEvaluated (cbatch ((cpending 4)) (context squared_error 0) 0))))
              (candidateInvalid "NonFinite"))
;; A cache entry for a valid context cannot mask invalid mode/target settings.
!(assertEqual (candidateStatus (car-atom (batchEvaluated (cbatch ((cpending 0))
                (mkContinCtx (data) squared_error 0 invalidMode 0) 1)))) (candidateInvalid "InvalidContext"))
!(assertEqual (candidateStatus (car-atom (batchEvaluated (cbatch ((cpending 0))
                (mkContinCtx (data) squared_error 0 linear "bad") 1)))) (candidateInvalid "InvalidContext"))
!(assertEqual (get-state &continCalls) 9)
!(assertEqual (materializeCandidateForContext rep id (mkInst ()) (context squared_error 0))
              (mkCEvalError "InvalidContinuousRepresentation"))
!(assertEqual (csummary (evaluateCandidateBatch ((cpending 0) (cpending 0)) rep id (context squared_error 0) 0))
              (2 0 0 1 1))
!(assertEqual (get-state &continCalls) 9)
